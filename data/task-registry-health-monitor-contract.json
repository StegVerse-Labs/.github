{
  "schema": "stegverse.task-registry-health-monitor-contract/v1",
  "status": "CANONICAL_ACTIVE",
  "purpose": "Continuously reconcile canonical task lifecycle, checkout state, worker-return obligations, Master Records returns, one-hop retirement readiness, and StegHealth recovery creation without creating a second scheduler or task authority.",
  "reporting_postures": {
    "ACTIVE": "Nonterminal task with checked-out/current execution or an admitted continuation path.",
    "INACTIVE": "Nonterminal task not currently checked out and with no current worker execution. This is a monitor posture, not a lifecycle state.",
    "COMPLETED": "Primary task work is canonically complete but the task has not yet satisfied retirement closure.",
    "RETIRED": "Canonical RETIRED task. Terminal for execution; may be revived only into historical-evidence review mode without changing its RETIRED lifecycle.",
    "SUPERSEDED": "Canonical SUPERSEDED task. Redirect-only terminal identity.",
    "INVALID": "Canonical INVALID task. Fail-closed terminal identity."
  },
  "required_counts": [
    "ACTIVE",
    "INACTIVE",
    "COMPLETED",
    "RETIRED",
    "SUPERSEDED",
    "INVALID",
    "CHECKED_OUT",
    "CHECKED_OUT_WITH_RETURN_OVERDUE",
    "CHECKED_OUT_WITH_WORKER_NONREPORT",
    "COMPLETED_BLOCKED_FROM_RETIREMENT_BY_OPEN_ONE_HOP_RELATED_TASKS",
    "RECOVERY_TASKS_DERIVED",
    "RECOVERY_TASKS_ALREADY_REGISTERED"
  ],
  "checked_out_review": {
    "required": true,
    "source": "CANONICAL_TASK_REGISTRY_PLUS_WORKER_RETURN_OBLIGATIONS_PLUS_MASTER_RECORDS",
    "signals": [
      "BOUND_WORKER_RETURN_OBLIGATION",
      "EXPECTED_EXPIRY_OR_RETURN_EXPECTATION",
      "MATCHING_MASTER_RECORDS_RETURN",
      "WORKER_RETRY_COUNTER",
      "CLAIM_OR_EXECUTION_REF",
      "CHECKOUT_STATE",
      "CURRENT_CANONICAL_LIFECYCLE"
    ],
    "symptoms": {
      "RETURN_PENDING": "Worker return expectation has not yet elapsed.",
      "RETRYING": "Worker remains within bounded retry resilience.",
      "RETURN_OVERDUE": "Expected return window elapsed and matching Master Records return is absent.",
      "WORKER_NONREPORT": "Independent evidence confirms the expected worker return never reached Master Records.",
      "RECONCILIATION_REQUIRED": "Partial/conflicting evidence prevents safe classification.",
      "HEALTHY": "Expected worker return/history is present and reconciled."
    }
  },
  "completed_retirement_review": {
    "required": true,
    "relationship_depth": 1,
    "open_lifecycles": ["ACTIVE", "COMPLETED"],
    "relationship_fields": [
      "parent_task_id",
      "dependency_refs",
      "dependencies",
      "adjacent_task_refs",
      "adjacent_tasks",
      "integration_candidates",
      "successor_task_id",
      "superseded_by_task_id"
    ],
    "retirement_allowed_only_when_no_immediate_or_one_hop_related_task_remains_open": true
  },
  "recovery_derivation": {
    "owner": "StegHealth",
    "create_only_when": [
      "RETURN_OVERDUE_WITH_RECOVERY_REQUIRED",
      "WORKER_NONREPORT",
      "RECONCILIATION_REQUIRED_WITH_TASK_AT_RISK"
    ],
    "must_deduplicate_against_existing_recovery_tasks": true,
    "must_preserve": [
      "source_task_id",
      "source_cosv_task_vector",
      "worker_return_obligation_ref",
      "claim_or_execution_ref",
      "master_records_subject_binding",
      "failure_observation_refs",
      "root_correlation_id"
    ],
    "new_recovery_task_requires_unique_task_id": true,
    "every_steghealth_recovery_task_must_be_registered_in_canonical_task_registry": true,
    "registration_must_bind_task_id_and_cosv": true,
    "steghealth_task_creation_is_recordable_ecosystem_action": true,
    "steghealth_task_creation_event_must_return_to_master_records": true,
    "recovery_task_creation_does_not_reopen_retired_task_for_execution": true,
    "retired_history_review_may_be_requested_only_for_historical_evidence_review": true,
    "recovery_task_creation_does_not_mint_execution_authority": true
  },
  "action_recording": {
    "all_monitor_actions_are_recordable_events": true,
    "all_steghealth_actions_are_recordable_events": true,
    "task_creation_event_required": true,
    "task_registration_event_required": true,
    "master_records_is_durable_record_destination": true
  },
  "monitor_output": {
    "must_receive_new_task_id_and_cosv": true,
    "must_report_status": true,
    "must_report_counts": true,
    "must_report_checked_out_findings": true,
    "must_report_completed_retirement_blocks": true,
    "must_report_derived_steghealth_recovery_tasks": true,
    "must_report_task_creation_and_registration_events": true,
    "must_not_invent_percent_complete": true
  },
  "invariants": [
    "MONITOR_IS_OBSERVER_AND_RECONCILER_NOT_SECOND_SCHEDULER",
    "INACTIVE_IS_REPORTING_POSTURE_NOT_CANONICAL_LIFECYCLE",
    "RETIRED_IS_TERMINAL_FOR_EXECUTION",
    "RETIRED_MAY_BE_REVIVED_ONLY_FOR_HISTORICAL_EVIDENCE_REVIEW",
    "COMPLETED_IS_NOT_RETIREMENT_READY_WHILE_ANY_IMMEDIATE_OR_ONE_HOP_RELATED_TASK_REMAINS_OPEN",
    "WORKER_RETRY_COUNTERS_ADD_RESILIENCE_BUT_DO_NOT_PROVE_NONREPORT",
    "WORKER_NONREPORT_REQUIRES_BOUND_EXPECTED_RETURN_AND_ABSENT_MASTER_RECORDS_RETURN",
    "EVERY_STEGHEALTH_RECOVERY_TASK_IS_A_CANONICAL_TASK_REGISTRY_ENTRY",
    "EVERY_STEGHEALTH_TASK_CREATION_OR_RECOVERY_ACTION_IS_A_RECORDABLE_ECOSYSTEM_EVENT",
    "RECOVERY_TASKS_ARE_CREATED_ONLY_FROM_EVIDENCE_AND_ARE_DEDUPLICATED",
    "MONITOR_REPORTS_COUNTS_WITHOUT_INVENTED_PROGRESS_PERCENTAGES"
  ],
  "refs": {
    "lifecycle_contract": "data/task-lifecycle-status-contract.json",
    "worker_return_contract": "data/worker-return-observation-contract.json",
    "canonical_registry": "data/canonical-task-registry.json",
    "sharded_task_records": "data/canonical-task-records/",
    "worker_registry": "control/worker-registry.json",
    "master_records_role": "MASTER_RECORDS",
    "steghealth_recovery_owner": "StegVerse-Labs/StegHealth"
  }
}
