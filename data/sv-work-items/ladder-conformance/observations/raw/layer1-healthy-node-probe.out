$ {python} -c import json, os, sys, tempfile
sys.path[:0] = [".", sys.argv[1]]
SIX = ("failure_code", "failed_predicate", "required_evidence_or_repair", "retry_entrypoint", "owning_existing_goal", "next_attempt")
with tempfile.TemporaryDirectory(dir=".") as root:
    os.environ["STEGVERSE_REPO_LEDGER_ROOT"] = root
    from llm_adapter import node_ingress_boundary as b
    from llm_adapter import healthy_node_evaluator as e
    sig = {"mode": "ESTABLISH_GENESIS", "predecessor": None, "node_class": "LLM_ADAPTER"}
    rows = []
    def keep(subject, out):
        r = {"subject": subject, "disposition": out.get("disposition"), "healthy_node_established": out.get("healthy_node_established")}
        for k in SIX + ("reason", "failed_stage"):
            if isinstance(out.get(k), str):
                r[k] = out[k]
        rows.append(r)
    for subject, extra, kw in (("HEALTH_REPORTED_UNHEALTHY", {}, {"health": lambda: {"status": "UNHEALTHY"}}),
                               ("HEALTH_NOT_SUPPLIED", {}, {}),
                               ("HEALTH_CALLER_ASSERTED_HEALTHY_UNRECEIPTED", {}, {"health": lambda: {"status": "HEALTHY"}}),
                               ("TRANSPORT_INTERLOCK_INTR_NOT_YET_ENABLED", {}, {"transport": b.INTERLOCK_INTR, "health": lambda: {"status": "HEALTHY"}}),
                               ("STANDING_REFUSED", {"mode": "NOT_A_MODE"}, {})):
        try:
            keep(subject, b.admit(dict(sig, node_ref="ladder-probe-" + subject.lower(), **extra), **kw))
        except Exception as exc:
            rows.append({"subject": subject, "disposition": "EXCEPTION", "exception": type(exc).__name__})
    for subject, kw in (("EVALUATOR_NO_LEDGER_HEAD", {"ledger_root": os.path.join(root, "missing")}),
                        ("EVALUATOR_TRANSPORT_NOT_INSTALLED", {"ledger_root": root, "transport_state": "NOT_YET_ENABLED"})):
        try:
            keep(subject, e.evaluate("ladder-probe-node", **kw))
        except Exception as exc:
            rows.append({"subject": subject, "disposition": "EXCEPTION", "exception": type(exc).__name__})
print(json.dumps({"rows": rows}, sort_keys=True))
 {root:sdk080}
