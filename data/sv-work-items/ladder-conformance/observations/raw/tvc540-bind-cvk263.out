position": "FAIL_CLOSED", "state": "KV_RECEIPT_CHAIN_DESIGNATED_ON_ORG_LEDGER", "subject": "TVC_MEMBERSHIP_ORG_REPOSITORY_IN_LOCATION_KV"}, {"cvk_contract_sha256": "sha256:83e30008addc557875f9cadf7f587a852e262d09ac50be9ecc041e9863d0b822", "cvk_head": "bf684aad", "disposition": "FAIL_CLOSED", "note": "the cvk contract file sha256 at the checked-out head vs TVC's KV_CONTRACT_PINS", "subject": "CVK_CONTRACT_DIGEST_VS_TVC_PIN_SKAP_VAULT", "tvc_pin": "sha256:3890351860f5df61c89b298b1a4dbf800e3897bab3841ed890cd49d864b23b21"}, {"detail": "skap_vault: not the one-store KV_STORAGE_ENDPOINT designation", "disposition": "FAIL_CLOSED", "note": "TVC's reader on the entry cvk's own custody_ledgers_config() returns at the checked-out head", "state": "KV_RECEIPT_CHAIN_STORE_NOT_STORAGE_ENDPOINT_V2", "subject": "TVC_READER_ON_CVK_HEAD_CUSTODY_LEDGERS_CONFIG_SKAP_VAULT"}, {"detail": "", "disposition": "ALLOW", "note": "positive control (pinned at the head TVC bound)", "state": "NOT_PINNED", "subject": "TVC_READER_ON_COMMITTED_CONFIG_SKAP_VAULT"}, {"detail": "", "disposition": "ALLOW", "state": "NOT_PINNED", "subject": "TVC_MEMBERSHIP_TOP_LEVEL_ORGANIZATION_SKAP_VAULT"}, {"detail": "", "disposition": "ALLOW", "state": "NOT_PINNED", "subject": "TVC_MEMBERSHIP_TOP_LEVEL_PERMISSIONS_SKAP_VAULT"}, {"detail": "", "disposition": "ALLOW", "state": "NOT_PINNED", "subject": "TVC_MEMBERSHIP_TOP_LEVEL_OWNER_SKAP_VAULT"}, {"detail": "", "disposition": "ALLOW", "state": "NOT_PINNED", "subject": "TVC_MEMBERSHIP_TOP_LEVEL_GITHUB_APP_INSTALLATION_ID_SKAP_VAULT"}, {"detail": "team is an org-membership, team, app-installation or org-ledger-writer binding", "disposition": "FAIL_CLOSED", "state": "ENDPOINT_ORG_MEMBERSHIP_REFUSED", "subject": "TVC_MEMBERSHIP_TOP_LEVEL_TEAM_SKAP_VAULT"}, {"detail": "repository_ledger_location.ref 'refs/stegverse/organization-ledger' is an org-ledger ref, org repository or git-ref location", "disposition": "FAIL_CLOSED", "state": "KV_RECEIPT_CHAIN_DESIGNATED_ON_ORG_LEDGER", "subject": "TVC_MEMBERSHIP_ORG_LEDGER_REF_IN_LOCATION_SKAP_VAULT"}, {"detail": "repository_ledger_location.repository 'StegVerse-org/LLM-adapter' is an org-ledger ref, org repository or git-ref location", "disposition": "FAIL_CLOSED", "state": "KV_RECEIPT_CHAIN_DESIGNATED_ON_ORG_LEDGER", "subject": "TVC_MEMBERSHIP_ORG_REPOSITORY_IN_LOCATION_SKAP_VAULT"}, {"disposition": "FAIL_CLOSED", "failure_code": "KV_LEDGER_HEAD_SIGNER_NOT_PUBLISHED", "ledger_location": {"kv": "STEGVERSE_KV#KV_INTR_ENDPOINT:_StegVerse/Receipts", "skap_vault": "STEGVERSE_KV#KV_INTR_ENDPOINT:_Vault/SKAP/Receipts"}, "signers": [], "subject": "TVC_KV_LEDGER_HEAD_SIGNER_STATE"}, {"cvk_file_sha256": "sha256:758d798388599171c145e3d19ca4eb155ad3d3762a3721804da65c08ebc1fe72", "cvk_head": "bf684aad", "disposition": "ALLOW", "subject": "TVC_KV_SIGNER_FILE_PIN_VS_CVK_HEAD", "tvc_pin": "sha256:758d798388599171c145e3d19ca4eb155ad3d3762a3721804da65c08ebc1fe72"}]}
