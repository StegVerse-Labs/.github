$ {python} -c import json, os, sys, tempfile, hashlib, subprocess
from pathlib import Path
from unittest import mock
os.environ['STEGVERSE_REPO_LEDGER_ROOT'] = tempfile.mkdtemp(prefix='lc-anchor-ledger-')
os.environ['STEGVERSE_GATEWAY_FORWARD_DB'] = os.path.join(tempfile.mkdtemp(prefix='lc-anchor-fwd-'), 'gateway-forward.db')
sys.path[:0] = ['.']
import tests
sys.path.append(sys.argv[1])
from llm_adapter import endpoint_ledger_anchor as anchor
from llm_adapter import healthy_node_evaluator as hne
from llm_adapter import node_ingress_boundary as boundary
from llm_adapter import org_ledger_location as location
import tests.test_endpoint_ledger_anchor as T
from tests import org_ledger_harness as harness
import contextlib
SIX = ("failure_code", "failed_predicate", "required_evidence_or_repair", "retry_entrypoint", "owning_existing_goal", "next_attempt")
rows = []
def row(subject, out, note=None):
    r = {"subject": subject, "disposition": out.get("disposition")}
    for k in SIX + ("reason",):
        if isinstance(out.get(k), str):
            r[k] = out[k]
    r["six_fields_present"] = all(isinstance(out.get(k), str) and out[k].strip() for k in SIX) if out.get("disposition") != "ALLOW" else None
    if note:
        r["note"] = note
    rows.append(r)
ROUTE = True   # rows run inside the TEST-ONLY append_route() harness (an admitted append route's stand-in) unless stated
def case(fn, production_signers=False, route=None):
    t = T.CallerStoreAndIngressTests("test_production_refuses_every_positive_control")
    t.setUp()
    ctx = harness.append_route() if (ROUTE if route is None else route) else contextlib.nullcontext()
    try:
      with ctx:
        if production_signers:   # the real (empty) TV/TVC signer file instead of the suite's TEST-ONLY signer
            p = mock.patch.object(anchor, "load_opened_signers", T.PRODUCTION_LOAD_OPENED_SIGNERS); p.start(); t.addCleanup(p.stop)
        fn(t)
    except Exception as exc:
        rows.append({"subject": fn.__name__.upper(), "disposition": "EXCEPTION", "exception": type(exc).__name__, "message": str(exc)[:200]})
    finally:
        t.doCleanups()
# every case runs with #431's contract designation (the suite's fixture), except PRODUCTION_CONTRACT_* which uses the branch's own contract
def unanchored(t):
    anchor.open_ledger(t.node, T.NODE, "EPHEMERAL", T.KEY, "StegNode")
    t.chain_to_admission()
    row("UNANCHORED_ROOT_VIA_BARE_EVALUATOR", hne.evaluate(T.NODE, ledger_root=t.node, require_admission=True),
        "observational: the bare evaluator (not evaluate_anchored) ALLOWs any root it is handed")
    row("UNANCHORED_ROOT_VIA_EVALUATE_ANCHORED", t.evaluate())
case(unanchored, True)
def no_genesis(t):
    t.chain_to_admission()
    row("ROOT_WITHOUT_GENESIS_VIA_EVALUATE_ANCHORED", t.evaluate())
case(no_genesis, True)
def head_mismatch(t):
    t.open_and_anchor()
    t.chain_to_admission()
    row("ORG_LEDGER_HEAD_NOT_THE_SUPPLIED_COPY", t.evaluate(head="sha256:" + "0" * 64))
case(head_mismatch)
def self_minted(t):
    genesis = anchor.open_ledger(t.node, T.NODE, "EPHEMERAL", T.KEY, "StegNode")["genesis"]
    anchor.anchor(t.node, t.org, T.NODE, T.opened_for(genesis))   # re-targeted, resealed, unsigned
    t.chain_to_admission()
    row("SELF_MINTED_ANCHOR_ON_CALLER_CREATED_ORG_LEDGER", t.evaluate())
    row("ANCHORED_ROOT_DEFAULT_TRANSPORT_STATE", t.evaluate(),
        "same setup as rev 4 (unsigned self-minted anchor): the anchor refusal is reached before transport")
    row("ANCHORED_ROOT_TRANSPORT_NOT_YET_ENABLED", t.evaluate(transport_state="NOT_YET_ENABLED"))
case(self_minted, True)
def own_key(t):
    anchor.open_ledger(t.node, T.NODE, "EPHEMERAL", T.KEY, "StegNode")
    seed = hashlib.sha256(b"lc probe: a caller's own seed").digest()
    anchor.anchor(t.node, t.org, T.NODE, T.sign_opened(T.STEGOS_OPENED, seed=seed, key_id="callers-own-key"))
    t.chain_to_admission()
    row("SELF_SIGNED_OPENED_RECORD_WITH_CALLERS_OWN_KEY", t.evaluate())
case(own_key, True)
def production_signers(t):
    t.open_and_anchor()   # signed with the suite's TEST-ONLY signer
    t.chain_to_admission()
    row("TEST_SIGNED_OPENED_RECORD_UNDER_PRODUCTION_SIGNER_FILE", t.evaluate(),
        "the TV/TVC signer file at this head lists no signer")
case(production_signers, True)
def transport_isolated(t):
    t.open_and_anchor()
    t.chain_to_admission(transport=boundary.HTTP)
    row("TRANSPORT_NOT_INTR_WITH_VALID_ANCHOR_DEFAULT_ARGUMENT", t.evaluate(), "E0 harness: TEST-ONLY signer")
    out = t.evaluate(transport_state="INSTALLED")
    row("TRANSPORT_ASSERTED_INSTALLED_NOT_OBSERVED", out, "E0 harness: TEST-ONLY signer; anchor %s" % (out.get("anchor") or {}).get("disposition"))
case(transport_isolated)
def forged_ingress(t):
    t.open_and_anchor()
    t.chain_to_admission(transport=boundary.HTTP)
    seen = [r for r in hne.read_chain(t.root)[0] if r["transition_class"] in (boundary.ADMITTED_CLASS, boundary.REFUSED_CLASS)][0]
    ev = dict(seen["evidence"])
    ev.update(transport=boundary.INTERLOCK_INTR, transport_state="INSTALLED", node_endpoint={"node_id": T.NODE})
    anchor._emitter().append(seen["transition_id"] + ":caller-appended", boundary.ADMITTED_CLASS, seen["receipt_sha256"],
                             hne.sha(ev), ev, "NONE", hb_epoch=10**12)
    out = t.evaluate()
    row("CALLER_APPENDED_INGRESS_RECORD_CLAIMING_INSTALLED_INTR", out,
        "observational: the node ledger is the caller's; the ingress record is appended by the caller, not by node_ingress_boundary over an installed transport (E0 harness: TEST-ONLY signer); anchor %s, intr_carrier_refusal %s" % ((out.get("anchor") or {}).get("disposition"), out.get("intr_carrier_refusal")))
case(forged_ingress)
def identity(t):
    t.open_and_anchor()
    t.chain_to_admission()
    row("IDENTITY_CLAIMED_NODE_ID_WITHOUT_PROOF", t.evaluate(claimed_node_id=T.NODE, prove=False))
    row("IDENTITY_PROOF_SIGNED_BY_ANOTHER_KEY", t.evaluate(identity_proof=t.prove(seed=hashlib.sha256(b"lc probe: other identity seed").digest())))
    row("IDENTITY_CLAIMED_NODE_ID_DIFFERS_FROM_PROOF", t.evaluate(claimed_node_id="SV-NODE-ffffffffffffffffffffffff"))
case(identity)
def org_location(t):
    t.open_and_anchor()
    t.chain_to_admission()
    row("ORG_LEDGER_GIT_DIR_IS_A_PLAIN_DIRECTORY", t.evaluate(git_dir=t.tree))
    with mock.patch.object(location, "CONTRACT_PATH", T.ROOT / ".stegverse/transition-ledger/contract.json"):
        row("PRODUCTION_CONTRACT_HAS_NO_ORG_LEDGER_DESIGNATION", t.evaluate())
case(org_location)
def caller_store_permanent(t):
    # (a): a PERMANENT root anchored on a git object store the caller created and filled (PERMANENT anchors use no signer)
    root = t.permanent_node("perm-node")
    own = hashlib.sha256(b"lc probe: a caller's own head attester").digest()
    store, head = t.caller_store("copy", with_anchor_of=root)
    t.chain_to_admission()
    row("PERMANENT_ROOT_ON_CALLER_CREATED_ORG_OBJECT_STORE", t.evaluate_on(store, head, root, None),
        "real genesis copied plus the caller's own anchor pair, no head attestation")
    row("CALLER_STORE_ATTESTED_BY_CALLERS_OWN_KEY", t.evaluate_on(store, head, root, harness.attest(store, seed=own, key_id="callers-own")))
    row("CALLER_STORE_ATTESTED_UNDER_THE_ROUTE_KEY_ID_WITH_OWN_SEED", t.evaluate_on(store, head, root, harness.attest(store, seed=own, key_id=harness.ROUTE_REF["key_id"])))
    t.publish()
    row("CALLER_STORE_WITH_THE_ROUTES_ATTESTATION_OF_THE_REAL_STORE_REPLAYED", t.evaluate_on(store, head, root, harness.attest(t.git)))
    minted, mhead = t.caller_store("minted", own_genesis=True)
    row("CALLER_STORE_WITH_ITS_OWN_GENESIS", t.evaluate_on(minted, mhead, root, harness.attest(minted)),
        "even attested by the (TEST-ONLY) route key")
    with mock.patch.object(location, "CONTRACT_PATH", T.CONTRACT_431):
        row("CONTRACT_WITHOUT_GENESIS_PIN", t.evaluate_on(store, head, root, harness.attest(store)),
            "#431's contract copy (no expected_genesis_receipt_sha256)")
case(caller_store_permanent, True)
def caller_store_permanent_forged_ingress(t):
    # (c): no transport patch (InTr NOT_YET_ENABLED as on main); the caller appends its own NODE_INGRESS_ADMITTED
    root = t.permanent_node("perm-node-2")
    anchor.anchor(root, t.org, T.NODE)
    t.chain_to_admission(installed=False)
    t.caller_appended_ingress()
    store, head = t.caller_store("caller-everything")
    row("PERMANENT_CALLER_STORE_AND_CALLER_APPENDED_INGRESS_NO_TRANSPORT_PATCH", t.evaluate_on(store, head, root, None))
    out = t.evaluate(t.endpoint("PERMANENT", root))
    row("ROUTE_ATTESTED_STORE_AND_CALLER_APPENDED_INGRESS_NO_TRANSPORT_PATCH", out,
        "anchor %s; intr_carrier_refusal %s" % ((out.get("anchor") or {}).get("disposition"), out.get("intr_carrier_refusal")))
case(caller_store_permanent_forged_ingress, True)
def positive(t):
    t.open_and_anchor()
    t.chain_to_admission()
    row("E0_POSITIVE_CONTROL_EPHEMERAL_TEST_SIGNER", t.evaluate(), "E0 harness: TEST-ONLY signer and #431 fixture contract")
case(positive)
def production(t):
    t.open_and_anchor()
    t.chain_to_admission()
    row("PRODUCTION_HEAD_SIGNERS_E0_POSITIVE_CONTROL", t.evaluate(),
        "outside append_route(): the real (empty) .stegverse/node-ledger/org-ledger-head-signers.v1.json")
case(production, False, False)
def production_bare(t):
    anchor.open_ledger(t.node, T.NODE, "EPHEMERAL", T.KEY, "StegNode")
    t.chain_to_admission()
    row("PRODUCTION_UNANCHORED_ROOT_VIA_BARE_EVALUATOR", hne.evaluate(T.NODE, ledger_root=t.node, require_admission=True),
        "observational: production signer files; the bare evaluator takes any root it is handed")
    row("PRODUCTION_UNANCHORED_ROOT_VIA_EVALUATE_ANCHORED", t.evaluate())
case(production_bare, True, False)
print(json.dumps({"rows": rows}, sort_keys=True))
