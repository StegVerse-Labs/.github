$ {python} -c import inspect, json, os, sys, tempfile
os.environ['STEGVERSE_REPO_LEDGER_ROOT'] = tempfile.mkdtemp(prefix='lc-anchor-ledger-')
os.environ['STEGVERSE_GATEWAY_FORWARD_DB'] = os.path.join(tempfile.mkdtemp(prefix='lc-anchor-fwd-'), 'gateway-forward.db')
sys.path[:0] = ['.']
import tests
sys.path.append(sys.argv[1])
from llm_adapter import endpoint_ledger_anchor as anchor
from llm_adapter import healthy_node_evaluator as hne
import tests.test_endpoint_ledger_anchor as T
SIX = ("failure_code", "failed_predicate", "required_evidence_or_repair", "retry_entrypoint", "owning_existing_goal", "next_attempt")
rows = []
def row(subject, out, note=None):
    r = {"subject": subject, "disposition": out.get("disposition")}
    for k in SIX + ("reason",):
        if isinstance(out.get(k), str):
            r[k] = out[k]
    if note:
        r["note"] = note
    rows.append(r)
def case(fn):
    t = T.AnchoredEndToEndTests("test_the_lc_kv_15_hole_is_closed")
    t.setUp()
    try:
        fn(t)
    except Exception as exc:
        rows.append({"subject": fn.__name__.upper(), "disposition": "EXCEPTION", "exception": type(exc).__name__, "message": str(exc)[:200]})
    finally:
        t.doCleanups()
def unanchored(t):
    anchor.open_ledger(t.node, T.NODE, "EPHEMERAL", T.KEY, "StegNode")
    t.chain_to_admission()
    row("UNANCHORED_ROOT_VIA_BARE_EVALUATOR", hne.evaluate(T.NODE, ledger_root=t.node, require_admission=True),
        "observational: the bare evaluator ALLOWs any root it is handed")
    row("UNANCHORED_ROOT_VIA_EVALUATE_ANCHORED", t.evaluate(require_admission=True))
case(unanchored)
def no_genesis(t):
    t.chain_to_admission()
    row("ROOT_WITHOUT_GENESIS_VIA_EVALUATE_ANCHORED", t.evaluate(require_admission=True))
case(no_genesis)
def head_mismatch(t):
    t.open_and_anchor()
    t.chain_to_admission()
    row("ORG_LEDGER_HEAD_NOT_THE_SUPPLIED_COPY", t.evaluate(head="sha256:" + "0" * 64, require_admission=True))
case(head_mismatch)
def self_minted(t):
    genesis = anchor.open_ledger(t.node, T.NODE, "EPHEMERAL", T.KEY, "StegNode")["genesis"]
    rec = T.opened_for(genesis)  # the caller re-targets and reseals a NODE_LEDGER_OPENED record (self-hash, no signature)
    anchor.anchor(t.node, t.org, T.NODE, rec)  # into an org-ledger directory the caller created
    t.chain_to_admission()
    row("SELF_MINTED_ANCHOR_ON_CALLER_CREATED_ORG_LEDGER", t.evaluate(require_admission=True),
        "observational: anchoring is checked against whatever org_ledger_root and head the caller passes; the NODE_LEDGER_OPENED record is sealed by its own sha256 only")
    row("ANCHORED_ROOT_DEFAULT_TRANSPORT_STATE", t.evaluate(require_admission=True),
        "observational: evaluate_anchored's transport_state defaults to %r" % inspect.signature(anchor.evaluate_anchored).parameters["transport_state"].default)
    row("ANCHORED_ROOT_TRANSPORT_NOT_YET_ENABLED", t.evaluate(require_admission=True, transport_state="NOT_YET_ENABLED"))
case(self_minted)
print(json.dumps({"rows": rows}, sort_keys=True))
