$ {python} -c import importlib.util, json, sys
spec = importlib.util.spec_from_file_location("sv_work_items", "resident-runtime/sv_work_items.py")
wi = importlib.util.module_from_spec(spec)
sys.modules["sv_work_items"] = wi
spec.loader.exec_module(wi)
rows = []
for line in open("data/sv-work-items/migration/sv-changes.jsonl", encoding="utf-8"):
    if not line.strip():
        continue
    c = json.loads(line)
    out = wi.admit(wi.admission_inputs(c, c["base_ref"]))
    rows.append(dict(out, subject="PRE_NATIVE_ADMIT_" + c["change_id"][4:16], change_id=c["change_id"], record_mode=c["record_mode"], projection_pr=c["projection"]["pr"], projection_repo=c["projection"]["repo"]))
print(json.dumps({"rows": rows}, sort_keys=True))

