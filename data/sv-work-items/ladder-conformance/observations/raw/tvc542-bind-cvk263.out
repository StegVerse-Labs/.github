$ {python} -c # P1 rev 11: TV/TVC readers (TVC#542/#540 scripts/tvc_org_ledger_head_signer.py ledger_location) against the
# custody_ledgers_config() continuity-vault-kit#263 returns at the head checked out in argv[1]; the committed
# config/kv_custody_receipt_chains.json; membership forms on the committed entry; the kv_ledger_head_signer state;
# and the cvk contract digests at that head. Pure reads; cvk imported from argv[1] in a subprocess.
import copy, hashlib, json, subprocess, sys
from pathlib import Path
sys.path[:0] = [".", "scripts"]
import tvc_org_ledger_head_signer as H
cvk = Path(sys.argv[1])
rows = []
SIX = ("failure_code", "failed_predicate", "required_evidence_or_repair", "retry_entrypoint", "owning_existing_goal", "next_attempt")
def row(subject, disp, note=None, **extra):
    r = {"subject": subject, "disposition": disp}
    if note: r["note"] = note
    r.update(extra); rows.append(r)
def state_row(subject, entry, which, note=None):
    _, state, detail = H.ledger_location(entry, which)
    disp = "ALLOW" if state in ("OK", "NOT_PINNED") else "FAIL_CLOSED"
    row(subject, disp, note, state=state, detail=detail[:300])
live = json.loads(subprocess.run([sys.executable, "-c", "import json,sys; sys.path.insert(0,'.'); from runtime import kv_receipt_ledgers as rl; print(json.dumps(rl.custody_ledgers_config()))"],
                                 cwd=cvk, capture_output=True, text=True, check=True).stdout)
head = subprocess.run(["git", "rev-parse", "HEAD"], cwd=cvk, capture_output=True, text=True).stdout.strip()
cfg = json.loads(Path("config/kv_custody_receipt_chains.json").read_text())
for which, f in (("kv", "stegverse-kv-receipts.contract.json"), ("skap_vault", "skap-receipts.contract.json")):
    got = "sha256:" + hashlib.sha256((cvk / ".stegverse/receipt-chains" / f).read_bytes()).hexdigest()
    row("CVK_CONTRACT_DIGEST_VS_TVC_PIN_" + which.upper(), "ALLOW" if got == H.KV_CONTRACT_PINS[which] else "FAIL_CLOSED",
        note="the cvk contract file sha256 at the checked-out head vs TVC's KV_CONTRACT_PINS", cvk_head=head[:8], cvk_contract_sha256=got, tvc_pin=H.KV_CONTRACT_PINS[which])
    entries = live.get("custody_ledgers", live) if isinstance(live, dict) else {}
    e = entries.get(which) if isinstance(entries, dict) else None
    # P1 rev 18: scripts/tvc_org_ledger_head_signer.py ledger_location reads TV/TVC's pin-WRAPPED entry (cvk's keys plus
    # KV_ENTRY_WRAPPER_KEYS: designation_sha256, source, designation, status; its own KV_ENTRY_CVK_KEYS comment), so a
    # raw cvk entry is refused by design; the raw row is kept for the record. The conforming reads are (1) TV/TVC's own
    # parser tools.kv_custody_ledgers_config.parse_entry on the raw entry, (2) the reader on the entry wrapped with the
    # sha256 TVC computes (designation_sha256) and a source taken only from cvk's own entry and head, and (3) the raw
    # entry equal to TVC's vendored snapshot entry. Nothing is taken from a caller; the pins still decide.
    state_row("TVC_READER_ON_CVK_HEAD_RAW_ENTRY_" + which.upper(), e, which,
              note="TVC's pin-wrapped-entry reader on the RAW entry cvk's custody_ledgers_config() returns: refused by design (no designation_sha256 or source wrapper)")
    wrapped = None
    if isinstance(e, dict):
        wrapped = dict(e)
        wrapped["designation_sha256"] = H.designation_sha256(e)
        wrapped["source"] = {"repository": "StegVerse-Labs/continuity-vault-kit", "pull_request": cfg["custody_ledgers"][which]["source"].get("pull_request"),
                             "commit": head, "accessor": "runtime.kv_receipt_ledgers.custody_ledgers_config()",
                             "contract_path": e.get("contract_path"), "contract_sha256": e.get("contract_sha256")}
    state_row("TVC_READER_ON_CVK_HEAD_WRAPPED_ENTRY_" + which.upper(), wrapped, which,
              note="TVC's reader on cvk's entry wrapped with designation_sha256 (computed by TVC) and a source built only from cvk's own entry and head")
    import tools.kv_custody_ledgers_config as T
    parsed, perr = T.parse_entry(which, copy.deepcopy(e))
    row("TVC_PARSER_ON_CVK_HEAD_CUSTODY_LEDGERS_CONFIG_" + which.upper(), "ALLOW" if parsed is not None else "FAIL_CLOSED",
        note="TVC's own tools.kv_custody_ledgers_config.parse_entry on the raw entry cvk returns at the checked-out head",
        failure_code=(perr or {}).get("failure_code"))
    snap = json.loads((Path(".") / T.SNAPSHOT_REL / T.CONFIG_FILE).read_text())
    row("CVK_ENTRY_EQUALS_TVC_VENDORED_SNAPSHOT_" + which.upper(), "ALLOW" if e == snap.get(which) else "FAIL_CLOSED",
        note="the raw entry cvk returns at the checked-out head vs the snapshot TVC vendors (" + T.SNAPSHOT_REL + ")", cvk_head=head[:8], tvc_snapshot_head=T.CVK_HEAD[:8])
    committed = cfg["custody_ledgers"][which]
    state_row("TVC_READER_ON_COMMITTED_CONFIG_" + which.upper(), committed, which, note="positive control (pinned at the head TVC bound)")
    forms = {
        "TOP_LEVEL_ORGANIZATION": lambda e: e.__setitem__("organization", "StegVerse-org"),
        "TOP_LEVEL_PERMISSIONS": lambda e: e.__setitem__("permissions", {"organization_members": "write"}),
        "TOP_LEVEL_OWNER": lambda e: e.__setitem__("owner", "StegVerse-org"),
        "TOP_LEVEL_GITHUB_APP_INSTALLATION_ID": lambda e: e.__setitem__("github_app_installation_id", 1),
        "TOP_LEVEL_TEAM": lambda e: e.__setitem__("team", "kv"),
        "ORG_LEDGER_REF_IN_LOCATION": lambda e: e["repository_ledger_location"].__setitem__("ref", "refs/stegverse/organization-ledger"),
        "ORG_REPOSITORY_IN_LOCATION": lambda e: e["repository_ledger_location"].__setitem__("repository", "StegVerse-org/LLM-adapter"),
    }
    for nm, edit in forms.items():
        e2 = copy.deepcopy(committed); edit(e2)
        state_row("TVC_MEMBERSHIP_%s_%s" % (nm, which.upper()), e2, which)
k = H.kv_ledger_head_signer()
row("TVC_KV_LEDGER_HEAD_SIGNER_STATE", k.get("disposition"), failure_code=k.get("failure_code"),
    signers=cfg["kv_ledger_head_signer"]["signer_source"].get("signers"), ledger_location=cfg["kv_ledger_head_signer"].get("ledger_location"))
sf = cvk / ".stegverse/node-ledger/kv-ledger-head-signers.v1.json"
got = "sha256:" + hashlib.sha256(sf.read_bytes()).hexdigest()
pin = cfg["kv_ledger_head_signer"]["signer_source"].get("file_sha256")
row("TVC_KV_SIGNER_FILE_PIN_VS_CVK_HEAD", "ALLOW" if got == pin else "FAIL_CLOSED", cvk_head=head[:8], cvk_file_sha256=got, tvc_pin=pin)
print(json.dumps({"rows": rows}, sort_keys=True))
 {root:cvk263}
