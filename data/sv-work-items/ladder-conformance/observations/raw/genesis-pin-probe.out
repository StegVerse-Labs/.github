$ {python} -c # LC rev 9 probe (#431 @66a098fa, LC-KV-19 head attestation): LLM-adapter#431 REPOSITORY_LEDGER_GENESIS_PIN planner and pre-pin InTr ingress receiver.
# Run from the #431 checkout with the org emitter root as argv[1]. Every ledger copy is a temporary bare repo built
# with #431's own emit.py and intr_transport_carrier builders; nothing touches a real ledger.
import json, os, sys, hashlib, importlib.util, contextlib
from pathlib import Path
from unittest import mock
sys.path[:0] = ['.', 'scripts']
import tests.test_llm_adapter_ledger_merge_transfer as T
from tests.test_llm_adapter_ledger_merge_transfer import P, R, M, carrier, receipt, git, NS, location, signer, ROUTE_REF, ROUTE_SEED, attest
ROUTE = mock.patch.object(location, 'load_head_signers', return_value=[dict(ROUTE_REF)])
ROUTE.start()  # rows run with the TEST-ONLY attester published unless a row says production
def att(bare, **kw):
    try:
        return attest(bare, **kw)
    except AssertionError:
        return None  # no readable chain to attest
import types
SIX = ("failure_code", "failed_predicate", "required_evidence_or_repair", "retry_entrypoint", "owning_existing_goal", "next_attempt")
rows = []
def row(subject, out, note=None, **extra):
    r = {"subject": subject, "disposition": out.get("disposition")}
    for k in SIX:
        if isinstance(out.get(k), str):
            r[k] = out[k]
    for k in ("carrier_reason",):
        if out.get(k):
            r[k] = out[k]
    r["six_fields_present"] = (all(isinstance(out.get(k), str) and out[k].strip() for k in SIX)
                               if out.get("disposition") == "FAIL_CLOSED" else None)
    r.update(extra)
    if note:
        r["note"] = note
    rows.append(r)

g = T.GenesisPinTransitionTests(); g.setUp()
BEFORE = g.before
CONTRACT = json.loads(BEFORE)
n = [0]
def ledger(*, genesis_evidence=None, carry=None, signal_for=None, tamper_dest=False, drop_source=False,
           no_genesis=False):
    """A ledger copy: (genesis), the INTR_MESH_PATH_INGRESS destination half, the retained source half."""
    n[0] += 1
    work = g.tmp / f"l{n[0]}-work"; work.mkdir(); store = work / NS
    gen = None
    if not no_genesis:
        gen = g.append(store, "REPOSITORY_LEDGER_INITIALIZATION:StegVerse-org/LLM-adapter",
                       "REPOSITORY_LEDGER_INITIALIZATION", "sha256:" + "0" * 64, "sha256:" + "1" * 64,
                       evidence=genesis_evidence or {"namespace": NS}, hb_epoch=446655631)
    gsha = signal_for or (gen["receipt_sha256"] if gen else "sha256:" + "c" * 64)
    signal = carry if carry is not None else R.genesis_signal(gsha, CONTRACT)
    cid = f"intr-path-v1:StegVerse-org/.github->StegVerse-org:genesis-pin:{n[0]}"
    src = receipt({"schema": carrier.RECEIPT_SCHEMA, "repository": "StegVerse-org/.github",
                   "transition_class": carrier.SOURCE_CLASS, "previous_receipt_sha256": None,
                   "evidence": carrier.source_evidence(signal, cid)})
    (store / "source-receipts").mkdir(parents=True)
    if not drop_source:
        (store / "source-receipts" / (src["receipt_sha256"][7:] + ".json")).write_text(json.dumps(src))
    dest = g.append(store, "INTR_MESH_PATH_INGRESS:" + cid, carrier.DESTINATION_CLASS, "sha256:" + "1" * 64,
                    "sha256:" + "2" * 64, evidence=carrier.destination_evidence(src), hb_epoch=446655632)
    if tamper_dest:
        p = store / "receipts" / (dest["receipt_sha256"][7:] + ".json")
        d = json.loads(p.read_text()); d["evidence"]["addressed_location"] = "elsewhere"; p.write_text(json.dumps(d))
    git(work, "init", "-q"); git(work, "add", "."); git(work, "commit", "-q", "-m", "ledger")
    bare = g.tmp / f"l{n[0]}.git"
    git(g.tmp, "clone", "-q", "--bare", str(work), str(bare))
    git(g.tmp, "--git-dir", str(bare), "update-ref", M.LEDGER_REF, "HEAD")
    cite = {"destination_receipt_sha256": dest["receipt_sha256"], "org_ledger_head_receipt_sha256": dest["receipt_sha256"],
            "org_ledger_head_attestation": att(str(bare))}
    return str(bare), gen, signal, cite

def recv(signal, cite, bare, contract=BEFORE):
    return R.receive(signal, intr_carrier=cite, org_ledger=bare, contract_bytes=contract)

# 1. positive control and the caller-written genesis-observed record
bare, gen, sig, cite = ledger()
ok = recv(sig, cite, bare)
row("GENESIS_OBSERVED_SIGNAL_CARRIED_ON_A_LEDGER_COPY", ok,
    "positive control: genesis, carrier pair and copy all built with #431's own emit.py and carrier builders")
cb, cg, cs, cc = ledger(genesis_evidence={"namespace": NS, "minted_by": "caller"})
caller = recv(cs, {**cc, "org_ledger_head_attestation": cite["org_ledger_head_attestation"]}, cb)
row("CALLER_WRITTEN_GENESIS_AND_CARRIER_ON_A_CALLER_LEDGER_COPY", caller,
    "a caller-created bare repo with the caller's own genesis and its own self-sealed InTr pair, citing the published "
    "(TEST-ONLY) signer's genuine attestation of the positive-control copy",
    planned_pin_is_caller_genesis=(caller.get("genesis_pin_plan") or {}).get("genesis_receipt_sha256") == cg["receipt_sha256"])
row("CALLER_LEDGER_COPY_UNATTESTED", recv(cs, {**cc, "org_ledger_head_attestation": None}, cb))
row("CALLER_LEDGER_COPY_ATTESTED_BY_CALLERS_OWN_KEY",
    recv(cs, {**cc, "org_ledger_head_attestation": att(cb, seed=b"p" * 32, key_id="p1-caller-key")}, cb))
row("CALLER_LEDGER_COPY_UNPUBLISHED_SEED_UNDER_THE_PUBLISHED_KEY_ID",
    recv(cs, {**cc, "org_ledger_head_attestation": att(cb, seed=b"p" * 32)}, cb))
row("ATTESTATION_NAMING_ANOTHER_NAMESPACE_TREE",
    recv(sig, {**cite, "org_ledger_head_attestation": att(bare, namespace_tree_oid="0" * 40)}, bare))
row("ATTESTATION_NAMING_ANOTHER_LOCATION",
    recv(sig, {**cite, "org_ledger_head_attestation": att(bare, org_ledger_location="refs/stegverse/organization-ledger:repository-ledger/x")}, bare))
with mock.patch.object(location, "load_head_signers", return_value=[]):
    row("PRODUCTION_SIGNERS_EMPTY_GENUINE_ATTESTED_COPY", recv(sig, cite, bare),
        "the committed org-ledger-head-signers.v1.json publishes no signer, so even the positive-control copy is refused")
    row("PRODUCTION_SIGNERS_EMPTY_CALLER_COPY", recv(cs, cc, cb))
row("PUBLISHED_SIGNERS_FILE", {"disposition": "NONE_PUBLISHED" if json.loads(Path(".stegverse/node-ledger/org-ledger-head-signers.v1.json").read_text()).get("signers") == [] else "PUBLISHED"},
    ".stegverse/node-ledger/org-ledger-head-signers.v1.json signers list")
nb, _, ns_, nc = ledger(no_genesis=True)
row("CALLER_SIGNAL_NAMING_A_GENESIS_NOT_ON_THE_LEDGER", recv(ns_, nc, nb))
ob, _, os_, oc = ledger(signal_for="sha256:" + "a" * 64)
row("CALLER_SIGNAL_NAMING_ANOTHER_GENESIS_THAN_THE_CHAIN_ROOT", recv(os_, oc, ob))

# 2. replay / real-shaped signal after the pin
pinned = P.apply_write(ok["genesis_pin_plan"], BEFORE)
row("SAME_SIGNAL_REPLAYED_AFTER_THE_PIN", recv(sig, cite, bare, pinned))
row("REAL_SHAPED_SIGNAL_FROM_ANOTHER_LEDGER_COPY_AFTER_THE_PIN", recv(cs, cc, cb, pinned))
row("PLANNER_DIRECT_AFTER_THE_PIN_OTHER_GENESIS", P.plan(org_ledger=cb, contract_bytes=pinned, org_ledger_head_attestation=att(cb)),
    "the planner alone, given a published-signer attestation of another copy, refuses to overwrite a pin")
again = P.plan(org_ledger=bare, contract_bytes=pinned, org_ledger_head_attestation=att(bare))
row("PLANNER_DIRECT_AFTER_THE_PIN_SAME_GENESIS", again, "idempotent: no write, no consumes receipt",
    already_pinned=again.get("already_pinned"), contract_write_is_none=again.get("contract_write") is None)

# 3. other signal types while the pin is null
node = {"node_ref": "n-1", "signal_class": "NODE_INGRESS_SIGNAL"}
nb2, _, _, nc2 = ledger(carry=node)
row("NODE_SIGNAL_GENUINELY_CARRIED_WHILE_PIN_NULL", recv(node, nc2, nb2))
row("GENESIS_SIGNAL_WITH_AN_EXTRA_KEY_WHILE_PIN_NULL", recv({**sig, "extra": 1}, cite, bare))
row("GENESIS_SIGNAL_OTHER_TRANSITION_CLASS_WHILE_PIN_NULL", recv({**sig, "transition_class": "OTHER"}, cite, bare))
row("NON_OBJECT_SIGNAL_WHILE_PIN_NULL", recv("REPOSITORY_LEDGER_GENESIS_OBSERVED", cite, bare))

# 4. forged carriers
fb, _, fs, fc = ledger(tamper_dest=True)
row("FORGED_CARRIER_DESTINATION_EDITED_AFTER_SEALING", recv(fs, fc, fb))
db, _, ds, dc = ledger(drop_source=True)
row("FORGED_CARRIER_SOURCE_HALF_NOT_RETAINED", recv(ds, dc, db))
bb, bg, _, bc = ledger(carry=node)
row("FORGED_CARRIER_BODY_IS_ANOTHER_SIGNAL", recv(R.genesis_signal(bg["receipt_sha256"], CONTRACT), bc, bb))
row("FORGED_CARRIER_HEAD_NOT_THE_READ_BACK_HEAD", recv(sig, {**cite, "org_ledger_head_receipt_sha256": gen["receipt_sha256"]}, bare))
row("FORGED_CARRIER_DESTINATION_NOT_ON_THE_CHAIN", recv(sig, {**cite, "destination_receipt_sha256": "sha256:" + "b" * 64}, bare))

# 4b. what the existing org emitter (StegVerse-org/.github@907f4305 resident-runtime/intr_path_transfer.py) produces
ORG = Path(sys.argv[1])
spec = importlib.util.spec_from_file_location("lc_org_ipt", ORG / "resident-runtime/intr_path_transfer.py")
ipt = importlib.util.module_from_spec(spec); sys.modules["lc_org_ipt"] = ipt; spec.loader.exec_module(ipt)
paths = ipt.declared_paths()
want_pid = carrier.path_id(R.EMITTER_REF)
declared = [p["path_id"] for p in paths]
row("ORG_EMITTER_DECLARES_THE_RECEIVERS_PATH", {"disposition": "DECLARED" if want_pid in declared else "UNDECLARED"},
    "intr_path_transfer.declared_paths(): ordered pairs of distinct organizations; the receiver's carrier path is "
    + want_pid, declared_path_count=len(paths), receiver_path_id=want_pid)
p0 = next(p for p in paths if p["source"] == "StegVerse-org") if any(p["source"] == "StegVerse-org" for p in paths) else paths[0]
ev = ipt.path_evidence(p0, "cid-lc", "0" * 40, "sha256:" + "a" * 64)
body_keys = sorted(ev["message"]["body"])
row("ORG_EMITTER_BODY_CAN_CARRY_THE_GENESIS_SIGNAL",
    {"disposition": "CARRIES" if set(R.SIGNAL_KEYS) <= set(ev["message"]["body"]) else "CANNOT_CARRY"},
    "intr_path_transfer.message() fixes the body", emitter_body_keys=body_keys,
    signal_keys=sorted(R.SIGNAL_KEYS),
    emitter_evidence_lacks=sorted({"destination_location", "endpoint_kind", "boundary_evidence"} - set(ev)))
osrc = receipt({"schema": carrier.RECEIPT_SCHEMA, "repository": "StegVerse-org/.github",
                "transition_class": carrier.SOURCE_CLASS, "previous_receipt_sha256": None, "evidence": ev})
try:
    carrier.destination_evidence(osrc); linked = {"disposition": "LINKABLE"}; why = None
except KeyError as exc:
    linked = {"disposition": "NOT_LINKABLE"}; why = "KeyError " + str(exc)
miss = [k for k in carrier.SOURCE_REBUILD_KEYS if k not in ev] if hasattr(carrier, "SOURCE_REBUILD_KEYS") else None
row("ORG_EMITTER_SHAPED_SOURCE_HALF_LINKED_BY_THE_CARRIER", linked,
    "intr_transport_carrier.destination_evidence over an INTR_MESH_PATH_TRANSFER receipt whose evidence is "
    "intr_path_transfer.path_evidence's", error=why, carrier_rebuild_keys_missing=miss)

# 4c. the typed writer in StegVerse-org/.github#235 (INTR-PATH-TRANSFER-TYPED-BODY-001, draft) given as argv[2]
if len(sys.argv) > 2:
    T235 = Path(sys.argv[2]).resolve()
    _cwd235 = os.getcwd(); os.chdir(T235)  # #235 reads its own contract relative to the checkout
    _o907 = str(Path(sys.argv[1]).resolve())
    for _n, _m in list(sys.modules.items()):  # #235's helpers must not reuse the main-head copies loaded above
        if str(getattr(_m, "__file__", "") or "").startswith(_o907):
            del sys.modules[_n]
    spec2 = importlib.util.spec_from_file_location("lc_org235_ipt", T235 / "resident-runtime/intr_path_transfer.py")
    ipt2 = importlib.util.module_from_spec(spec2); sys.modules["lc_org235_ipt"] = ipt2
    old_path = list(sys.path); sys.path.insert(0, str(T235 / "resident-runtime"))
    try:
        spec2.loader.exec_module(ipt2)
    finally:
        sys.path[:] = old_path
    grow = ipt2.genesis_observed_row("StegVerse-org/LLM-adapter", gen["receipt_sha256"])
    row("ORG235_TYPED_ROW_BODY_EQUALS_THE_RECEIVERS_SIGNAL",
        {"disposition": "EQUAL" if grow["typed_body"] == R.genesis_signal(gen["receipt_sha256"], CONTRACT) else "DIFFERENT"},
        "intr_path_transfer.genesis_observed_row(...)['typed_body'] vs #431's genesis_signal", typed_refusal=ipt2.typed_refusal(grow))
    tev = ipt2.typed_path_evidence(grow, "0" * 40, "sha256:" + "a" * 64)
    row("ORG235_TYPED_SOURCE_HALF_HAS_THE_CARRIER_REBUILD_KEYS",
        {"disposition": "COMPLETE" if all(k in tev for k in carrier.SOURCE_REBUILD_KEYS) else "INCOMPLETE"},
        missing=[k for k in carrier.SOURCE_REBUILD_KEYS if k not in tev])
    tsrc = receipt({"schema": carrier.RECEIPT_SCHEMA, "repository": "StegVerse-org/.github",
                    "transition_class": carrier.SOURCE_CLASS, "previous_receipt_sha256": None, "evidence": tev})
    try:
        carrier.destination_evidence(tsrc); tl = {"disposition": "LINKABLE"}
    except KeyError as exc:
        tl = {"disposition": "NOT_LINKABLE", "error": str(exc)}
    row("ORG235_TYPED_SOURCE_HALF_LINKED_BY_THE_CARRIER", tl)
    pids = [p["path_id"] for p in ipt2.declared_paths()]
    io_rows = ipt2.intra_org_paths() if hasattr(ipt2, "intra_org_paths") else []
    io_hit = ipt2.intra_org_path(ipt2.typed_path_id()) if hasattr(ipt2, "intra_org_path") else None
    row("ORG235_TYPED_PATH_IN_THE_DECLARED_PATH_DATA",
        {"disposition": "DECLARED_AS_INTRA_ORG_DATA_ROW" if io_hit else ("DECLARED" if ipt2.typed_path_id() in pids else "CODE_CONSTANT_ONLY")},
        "ruling 6371704941 defect 2 asks for the .github->StegVerse-org path as a data row (data/intr-protocol/v1/protocol.json mesh_path_transfer.intra_org_paths at #235)",
        typed_path_id=ipt2.typed_path_id(), declared_path_count=len(pids), intra_org_path_rows=len(io_rows))
    if hasattr(ipt2, "genesis_observed_row_from_readback"):
        rb = {"disposition": "ALLOW", "repository_ledger": {"namespace": "repository-ledger/StegVerse-org/LLM-adapter",
              "genesis_receipt_sha256": gen["receipt_sha256"], "chain": [gen],
              "every_receipt_verifies_against_its_body": True, "every_receipt_retained_in_organization_ledger": True}}
        fr = ipt2.genesis_observed_row_from_readback(rb)
        ok_rb = fr.get("disposition") not in ("FAIL_CLOSED", "DENY") and ipt2.typed_refusal(fr) is None
        row("ORG235_TYPED_ROW_FROM_READBACK", {"disposition": "EMITTED" if ok_rb else "REFUSED"},
            "typed-row --from-readback over a read-back document shaped as organization_ledger_readback.py's; pure, prints the row only",
            body_equals_receivers_signal=(fr.get("typed_body") == R.genesis_signal(gen["receipt_sha256"], CONTRACT)) if ok_rb else None)
        bad = {"disposition": "ALLOW", "repository_ledger": {"namespace": "repository-ledger/StegVerse-org/LLM-adapter",
               "genesis_receipt_sha256": "sha256:" + "b" * 64, "chain": [gen],
               "every_receipt_verifies_against_its_body": True, "every_receipt_retained_in_organization_ledger": True}}
        row("ORG235_TYPED_ROW_FROM_READBACK_GENESIS_NOT_THE_CHAIN_ROOT", ipt2.genesis_observed_row_from_readback(bad))
        row("ORG235_TYPED_ROW_FROM_READBACK_UNVERIFIED", ipt2.genesis_observed_row_from_readback({**rb, "repository_ledger": {**rb["repository_ledger"], "every_receipt_verifies_against_its_body": False}}))
    wf = sorted(str(x.relative_to(T235)) for x in (T235 / ".github/workflows").glob("*.yml") if "from-readback" in x.read_text())
    row("ORG235_FROM_READBACK_WIRED_TO_A_TRANSITION", {"disposition": "WIRED" if wf else "NOT_WIRED"},
        "a workflow at #235 that runs typed-row --from-readback and lands the row in transfers.json", workflows=wf)
    src235 = (T235 / "resident-runtime/intr_path_transfer.py").read_text()
    row("ORG235_DESTINATION_HALF_WRITER",
        {"disposition": "PRESENT" if "INTR_MESH_PATH_INGRESS" in src235 and "repository-ledger/" in src235 and "DESTINATION_CLASS" in src235 else "ABSENT"},
        "who appends the INTR_MESH_PATH_INGRESS destination half into repository-ledger/<repo> that #431's receiver reads; #431's fixture test builds it with carrier.destination_evidence")
    gwrow = {**grow, "endpoint_kind": "GATEWAY", "ledger_root": "/elsewhere"}
    row("ORG235_GATEWAY_ROW_WITH_EXTERNAL_LEDGER_REF", ipt2.typed_refusal(gwrow) or {"disposition": "ACCEPTED"})
    other = {**grow, "typed_body": {**grow["typed_body"], "schema": "stegverse.other/v1"}}
    other["typed_body_sha256"] = ipt2.sha(other["typed_body"])
    row("ORG235_TYPED_BODY_SCHEMA_NOT_ALLOWLISTED", ipt2.typed_refusal(other) or {"disposition": "ACCEPTED"})
    row("ORG235_TYPED_BODY_UNSEALED", ipt2.typed_refusal({**grow, "typed_body_sha256": "sha256:" + "0" * 64}) or {"disposition": "ACCEPTED"})
    os.chdir(_cwd235)

# 4d. contract-path parameter (Lane D finding 5)
row("CONTRACT_PATH_TRAVERSAL", P.plan(org_ledger=bare, contract_path="../.stegverse/transition-ledger/contract.json"))
row("CONTRACT_PATH_UNLISTED", P.plan(org_ledger=bare, contract_path=".stegverse/receipt-ledgers/03_Other.contract.json"))
if len(sys.argv) > 3:
    CVK = sys.argv[3]
    for rel in P.CONTRACT_PATHS[1:]:
        r_ = P.plan(org_ledger=bare, contract_path=rel, checkout=CVK, org_ledger_head_attestation=att(bare))
        row("CVK263_CONTRACT_PLANNED_" + rel.rsplit("/", 1)[-1].split(".")[0], r_,
            "cvk#263 head contract through #431's allowlisted path, against the LLM-adapter positive-control copy (another namespace)")

# 5. circularity: the receiver must not reach the pin-gated read, and the planner must not reach the receiver
boom = mock.Mock(side_effect=AssertionError("pin-gated read reached"))
with mock.patch.object(location, "designated_org_ledger", boom), mock.patch.object(carrier, "observe", boom):
    nocyc = recv(sig, cite, bare)
row("RECEIVER_WITH_PIN_GATED_READS_DISABLED", nocyc,
    "#431 now carries a byte copy of #432's org_ledger_location for the head check; its pin-gated "
    "designated_org_ledger and intr_transport_carrier.observe are patched to raise", pin_gated_read_calls=boom.call_count,
    org_ledger_location_in_431=Path("llm_adapter/org_ledger_location.py").exists())
import ast
def imports(path):
    names = set()
    for node_ in ast.walk(ast.parse(Path(path).read_text())):
        if isinstance(node_, ast.Import):
            names |= {a.name for a in node_.names}
        elif isinstance(node_, ast.ImportFrom):
            names.add(node_.module or "")
    return sorted(names)
pi, ri = imports("scripts/llm_adapter_repository_ledger_genesis_pin.py"), imports("scripts/llm_adapter_genesis_pin_ingress.py")
row("PLANNER_AND_RECEIVER_IMPORT_GRAPH",
    {"disposition": "ACYCLIC" if "llm_adapter_genesis_pin_ingress" not in pi and "llm_adapter.org_ledger_location" not in ri
     else "CYCLIC"}, planner_imports=pi, receiver_imports=ri)

# 6. the pin written equals the digest read back
w = ok["genesis_pin_plan"]["contract_write"]
head = json.loads(P.M._git(bare, "show", f"{M.LEDGER_REF}:{NS}/HEAD.json"))
cur, root_doc = head["receipt_sha256"], None
while cur:
    root_doc = json.loads(P.M._git(bare, "show", f"{M.LEDGER_REF}:{NS}/receipts/{cur[7:]}.json"))
    cur = root_doc.get("previous_receipt_sha256")
body = {k: v_ for k, v_ in root_doc.items() if k != "receipt_sha256"}
recomputed = "sha256:" + hashlib.sha256(json.dumps(body, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()).hexdigest()
written = json.loads(pinned)["repository_ledger_location"]["expected_genesis_receipt_sha256"]
row("PIN_WRITTEN_EQUALS_THE_DIGEST_READ_BACK",
    {"disposition": "EQUAL" if written == root_doc["receipt_sha256"] == recomputed == w["value"] else "DIFFERENT"},
    "the written contract field vs the chain root read back from the copy (git show) and its re-hashed body",
    after_sha256_matches=w["after_sha256"] == "sha256:" + hashlib.sha256(pinned).hexdigest(),
    consumes_receipt_sha256_is_root=ok["genesis_pin_plan"]["consumes_receipt"]["emit_append"]["evidence"]["consumes_receipt_sha256"] == written)
stale = BEFORE + b" "
try:
    P.apply_write(ok["genesis_pin_plan"], stale); res = {"disposition": "WRITTEN"}
except ValueError as exc:
    res = {"disposition": "REFUSED"}
row("APPLY_WRITE_ON_A_CHANGED_CONTRACT", res, "apply_write checks the plan's before digest")

# 7. production: the branch's own contract, no ledger copy
with mock.patch.object(location, "load_head_signers", return_value=[]):
    row("PRODUCTION_RECEIVER_WITHOUT_A_LEDGER_COPY", R.receive(sig, intr_carrier=cite, org_ledger=None))
ROUTE.stop()
g.tearDown()
print(json.dumps({"rows": rows}, sort_keys=True))
