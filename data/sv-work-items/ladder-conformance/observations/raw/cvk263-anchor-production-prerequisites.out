$ {python} -c # P1 rev 16 (StegVerse-org/.github#163): the cvk-only both-ends anchor's production prerequisites, read from
# continuity-vault-kit's own receipt_ledger_prerequisites() and ORG_CROSSING_READER at the checked-out head. Pure reads;
# nothing is written, no ledger is dispatched, no key is generated.
import json
from runtime import kv_receipt_ledgers as k
SIX = ("failure_code", "failed_predicate", "required_evidence_or_repair", "retry_entrypoint", "owning_existing_goal", "next_attempt")
rows = []
for r in k.receipt_ledger_prerequisites():
    w = r["receipt_ledger"].upper()
    for b in r.get("fail_closed", []):
        rows.append(dict({x: b.get(x) for x in SIX}, subject="PROD_PREREQ_%s_%s" % (b["failure_code"], w), disposition="FAIL_CLOSED"))
    rows.append(dict({x: r.get(x) for x in SIX if x in r}, subject="PROD_PREREQ_ROW_" + w, disposition=r["disposition"]))
installed = callable(k.ORG_CROSSING_READER)
row = {"subject": "ORG_CROSSING_READER_INSTALLED", "disposition": "ALLOW" if installed else "FAIL_CLOSED"}
if not installed:
    n = k.not_observed("kv", "ORG_CROSSING_READER is None at this head: no reader of the Org side of the crossing is installed",
                       predicate="KV_HEAD_RECORDED_AT_BOTH_ENDS")
    row.update({x: n[x] for x in SIX})
rows.append(row)
print(json.dumps({"rows": rows}, sort_keys=True))

