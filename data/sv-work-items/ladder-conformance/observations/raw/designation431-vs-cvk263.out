$ {python} -c # P1 rev 11: LLM-adapter#431 endpoint_ledger_designation against continuity-vault-kit#263's committed ledger
# designations (cvk263 checkout = argv[1]), plus Coordination's provisional membership ruling (#167 6373412055)
# item 3 (PERMANENT node ledger on an org GIT_REF is membership; ORG-kind GIT_REF is fine). Pure functions only.
import copy, json, re, sys
from pathlib import Path
sys.path[:0] = ["."]
from llm_adapter import endpoint_ledger_designation as E
cvk = Path(sys.argv[1])
FX = Path("tests/fixtures/endpoint-ledger-designation")
SIX = ("failure_code", "failed_predicate", "required_evidence_or_repair", "retry_entrypoint", "owning_existing_goal", "next_attempt")
rows = []
def row(subject, out, note=None, **extra):
    r = {"subject": subject}
    if out is None:
        r["disposition"] = "ALLOW"
    elif isinstance(out, dict):
        r["disposition"] = out.get("disposition")
        for k in SIX:
            if isinstance(out.get(k), str): r[k] = out[k]
    else:
        r["disposition"] = out
    if note: r["note"] = note
    r.update(extra); rows.append(r)
for name, f in (("KV", "stegverse-kv-receipts.contract.json"), ("SKAP_VAULT", "skap-receipts.contract.json")):
    c = json.loads((cvk / ".stegverse/receipt-chains" / f).read_text())
    d = c["ledger_designation"]
    row("CVK263_%s_DESIGNATION_UNDER_431" % name, E.designation_failure(d),
        store_type=d["stores"][0].get("store_type"), accepted_store_types=list(E.STORE_TYPES),
        note="#431 reads the designation Lane D committed for this chain")
cvk_rl = (cvk / "runtime/kv_receipt_ledgers.py").read_text()
m = re.search(r'^HEAD_DIGEST_NAME = "([A-Z_]+)"', cvk_rl, re.M)
signs_cvk = m.group(1) if m else None
signs_431 = E.HEAD_SIGNER_FILES[E.KV_LEDGER_HEAD_SIGNER][1]
row("KV_HEAD_SIGNER_SIGNS_VALUE_431_VS_CVK263", "ALLOW" if signs_cvk == signs_431 else "FAIL_CLOSED",
    note="informational: one kv-ledger-head-signers.v1.json entry is accepted by a reader only when its signs value matches",
    signs_431=signs_431, signs_cvk263=signs_cvk)
m = re.search(r"^STORE_KEYS = \(([^)]*)\)", cvk_rl, re.M | re.S)
cvk_keys = tuple(sorted(re.findall(r'"([a-z_]+)"', m.group(1)))) if m else None
row("KV_STORE_KEYS_431_VS_CVK263", "ALLOW" if cvk_keys == E.STORE_KEYS[E.KV_STORAGE_ENDPOINT] else "FAIL_CLOSED",
    note="informational: #431's KV_STORAGE_ENDPOINT store keys equal cvk's STORE_KEYS", keys_431=list(E.STORE_KEYS[E.KV_STORAGE_ENDPOINT]), keys_cvk263=list(cvk_keys or ()))
org = json.loads((FX / "org-git-ref.designation.json").read_text())
row("ORG_KIND_GIT_REF_DESIGNATION", E.designation_failure(org),
    note="ruling item 3: ORG-kind stores on GIT_REF are the Org's own ledger and are fine", repository=org["stores"][0].get("repository"))
node = {**copy.deepcopy(org), "endpoint_kind": "PERMANENT", "endpoint_id": "node-1"}
row("PERMANENT_NODE_LEDGER_ON_ORG_GIT_REF", E.designation_failure(node),
    note="ruling item 3 requires DENY ENDPOINT_ORG_MEMBERSHIP_REFUSED", repository=node["stores"][0].get("repository"))
kvd = json.loads((FX / "kv.designation.json").read_text())
row("KV_FIXTURE_DESIGNATION", E.designation_failure(kvd), note="positive control")
for nm, edit in (("TOP_LEVEL_ORGANIZATION", lambda d: d.__setitem__("organization", "StegVerse-org")),
                 ("STORE_GITHUB_APP_INSTALLATION_ID", lambda d: d["stores"][0].__setitem__("github_app_installation_id", "1")),
                 ("WATERMARK_SOURCE_TEAM", lambda d: d["rollback_watermark_source"].__setitem__("team", "kv")),
                 ("KV_ON_ORG_GIT_REF", lambda d: d.__setitem__("stores", json.loads((FX / "kv-on-org-git-ref.designation.json").read_text())["stores"]))):
    d = copy.deepcopy(kvd); edit(d)
    row("MEMBERSHIP_FORM_%s_UNDER_431" % nm, E.designation_failure(d))
src = open(E.__file__).read()
row("ENDPOINT_ORG_MEMBERSHIP_REFUSED_CODE_IN_431", "PRESENT" if "ENDPOINT_ORG_MEMBERSHIP_REFUSED" in src else "ABSENT",
    note="informational: the code Coordination's ruling (#167 6373412055 item 3) and cvk#263 use")
print(json.dumps({"rows": rows}, sort_keys=True))
 {root:cvk263}
