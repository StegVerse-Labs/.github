$ {python} -c import json,subprocess,sys
rows=[]
def run(tag, args):
    p=subprocess.run([sys.executable,'scripts/llm_adapter_repository_ledger_genesis_pin.py','precompute','--predecessor-state-sha256','sha256:'+'0'*64,'--successor-state-sha256','sha256:'+'1'*64]+args,capture_output=True,text=True)
    try: o=json.loads(p.stdout)
    except Exception: o={'disposition':'EXCEPTION','exception':'non-JSON stdout','message':(p.stdout+p.stderr)[-300:]}
    o=dict(o); o['subject']=tag; o.setdefault('disposition','RETURNED_WITHOUT_DISPOSITION'); rows.append(o); return o
a=run('GENESIS_PRECOMPUTE_EPOCH_64_FIRST',['--hb-epoch','64']); b=run('GENESIS_PRECOMPUTE_EPOCH_64_SECOND',['--hb-epoch','64']); c=run('GENESIS_PRECOMPUTE_EPOCH_65',['--hb-epoch','65'])
run('GENESIS_PRECOMPUTE_NO_EPOCH',[]); run('GENESIS_PRECOMPUTE_EPOCH_INVALID_31',['--hb-epoch','31'])
g=lambda o: o.get('expected_genesis_receipt_sha256')
rows.append({'subject':'GENESIS_PRECOMPUTE_DETERMINISTIC','disposition':'ALLOW' if g(a) and g(a)==g(b) and g(a)!=g(c) else 'FAIL_CLOSED','failure_code':None if g(a) and g(a)==g(b) and g(a)!=g(c) else 'GENESIS_PRECOMPUTE_NOT_DETERMINISTIC','failed_predicate':'SAME_EPOCH_SAME_DIGEST','required_evidence_or_repair':'genesis digest a pure function of SUPPLIED_HB_EPOCH','retry_entrypoint':'expected-genesis','owning_existing_goal':'LC-KV-19','next_attempt':'on the next push to LLM-adapter#431','epoch_64':g(a),'epoch_65':g(c)})
print(json.dumps({'rows':rows}))

