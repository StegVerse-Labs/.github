$ {python} -c import json
import tvc_skap_custody_reference_issuance as t
SIX = ("failure_code", "failed_predicate", "required_evidence_or_repair", "retry_entrypoint", "owning_existing_goal", "next_attempt")
rows = []
def keep(subject, out):
    r = {"subject": subject, "disposition": out.get("disposition")}
    for k in SIX + ("failure_class", "custody_key_ref"):
        if isinstance(out.get(k), str):
            r[k] = out[k]
    rows.append(r)
keep("ISSUE_INVALID_MANIFEST", t.issue({}))
keep("ISSUE_MANIFEST_CARRYING_MATERIAL", t.issue(dict(t.build_manifest(principal_ref="principal:probe"), private_key="x")))
ok = t.issue(t.build_manifest(principal_ref="principal:probe"))
keep("ISSUE_VALID_MANIFEST", ok)
keep("VERIFY_EDITED_RECEIPT", t.verify(dict(ok, custody_key_ref="tvc://skap-custody/forged")))
keep("VERIFY_ISSUED_RECEIPT", t.verify(ok))
print(json.dumps({"rows": rows}, sort_keys=True))

--- exit 0
