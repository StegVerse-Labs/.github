$ {python} -c import importlib, json, sys
sys.path[:0] = ["."]
from tools import skap_custody_chain as c
from tools import coinbase_intr_double_interlock as d
from tools.kv_two_layer_receipts import sha256_uri
SIX = ("failure_code", "failed_predicate", "required_evidence_or_repair", "retry_entrypoint", "owning_existing_goal", "next_attempt")
rows = []
def keep(subject, out, note=None):
    r = {"subject": subject, "disposition": out.get("disposition") if isinstance(out, dict) else out}
    if isinstance(out, dict):
        for k in SIX + ("failure_class",):
            if isinstance(out.get(k), str):
                r[k] = out[k]
        if isinstance(out.get("chain_blockers"), list):
            r["chain_blockers"] = ",".join(out["chain_blockers"])
    if note: r["note"] = note
    rows.append(r)
def sealed(body):
    return dict(body, receipt_hash=sha256_uri(body))
SUBJ = "skap://APIs/probe/v1"
# layer receipts minted by the caller itself: no KVInterlockRuntime, no SkapLayer2Gate, no node, no InTr exchange
L1 = sealed({"schema": "stegverse.kv-access-receipt/v1", "layer": 1, "hop_index": 0, "from_role": "DEVICE", "to_role": "KV",
             "minted_by": "KVInterlockRuntime.handle", "prior_receipt_hash": None, "healthy_node_receipt": {},
             "authority_effect": "NONE", "intr_receipt_ref": "sha256:" + "1" * 64})
def l2(prior, **kw):
    b = {"schema": "stegverse.skap-access-receipt/v1", "layer": 2, "hop_index": 1, "from_role": "KV", "to_role": "SKAP_VAULT",
         "minted_by": "SkapLayer2Gate.admit", "authority_effect": "NONE", "prior_receipt_hash": prior,
         "layer1_intr_receipt_ref": L1["intr_receipt_ref"], "subject_ref": SUBJ, "operation": "SKAP_SEALED_CREDENTIAL_READ"}
    b.update(kw)
    return sealed(b)
MAN = json.load(open("config/skap-custody-chain.manifest.json"))
class CallerClient:
    def __init__(self): self.records = {"skap-vault://caller/1": {"schema": "caller-record"}}
    def place(self, req): return {}
    def read(self, req):
        rec = self.records.get(req["custody_ref"])
        return {"schema": c.READ_RECEIPT_SCHEMA, "custody_ref": req["custody_ref"], "record": rec,
                "record_sha256": sha256_uri(rec), "admission_hash": req["admission"]["admission_hash"]}
def chain(**kw):
    d = {"manifest": MAN, "kv_access_receipt": L1, "skap_access_receipt": l2(L1["receipt_hash"]), "custody_issuance_receipt": {},
         "skap_vault_intr_client": CallerClient()}
    d.update(kw)
    return d
G = lambda ch, store="skap_resident_sealed_object", subj=SUBJ: c.gate(store, "read", subject_ref=subj, chain=ch)
keep("CHAIN_INPUTS_ABSENT", G(None))
keep("CHAIN_STORE_NOT_IN_MANIFEST", G(chain(), store="caller_named_store"))
keep("CHAIN_SUBJECT_OUTSIDE_STORE_SCOPE", G(chain(), store="skap_resident_seal_activation"))
keep("CHAIN_LAYER1_RECEIPT_ABSENT", G(chain(kv_access_receipt=None)))
keep("CHAIN_LAYER1_RECEIPT_HASH_EDITED", G(chain(kv_access_receipt=dict(L1, receipt_hash="sha256:" + "2" * 64))))
keep("CHAIN_LAYER2_NOT_BOUND_TO_LAYER1", G(chain(skap_access_receipt=l2("sha256:" + "3" * 64))))
keep("CHAIN_CALLER_MINTED_LAYERS_TVC537_NOT_ON_PATH", G(chain()),
     "the caller-minted layer receipts pass verify_two_layers; the refusal is the absent TVC#537 module")
sys.path.insert(0, sys.argv[1])  # TVC#537's issuance module, as it would be once on TVC main
importlib.invalidate_caches()
t = importlib.import_module("tvc_skap_custody_reference_issuance")
issued = t.issue(t.build_manifest(principal_ref="principal:caller"))
keep("CHAIN_CALLER_MINTED_LAYERS_WITH_TVC537_ISSUED_RECEIPT_AND_CALLER_CLIENT", G(chain(custody_issuance_receipt=issued)),
     "observational: layer receipts are re-hashed, not checked against continuity-vault-kit's gates; the issuance receipt is caller-requested and unsigned; the client is the caller's")
keep("CHAIN_WITH_TVC537_EDITED_ISSUANCE_RECEIPT", G(chain(custody_issuance_receipt=dict(issued, custody_key_ref="tvc://skap-custody/forged"))))
keep("CHAIN_WITH_TVC537_NO_CLIENT_BOUND", G(chain(custody_issuance_receipt=issued, skap_vault_intr_client=None)))
try:
    rec = c.read_through_chain("skap_resident_sealed_object", "skap-vault://caller/1", subject_ref=SUBJ,
                               chain=chain(custody_issuance_receipt=issued))
    keep("READ_THROUGH_CHAIN_CALLER_MINTED_LAYERS", "ALLOW", "observational: returned the caller client's record %r" % (rec,))
except c.SkapCustodyChainRefused as exc:
    keep("READ_THROUGH_CHAIN_CALLER_MINTED_LAYERS", exc.refusal)

import inspect as _insp
if not hasattr(d, "build_chain"):
    keep("DOUBLE_INTERLOCK_BUILD_CHAIN_ACCEPTS_CALLER_LAYER_RECEIPTS", "BUILD_CHAIN_ABSENT",
         "revision 11: tools/coinbase_intr_double_interlock.py has no build_chain; gates: " +
         ", ".join(n for n in ("gate_device_kv", "gate_kv_skap", "link_gates") if hasattr(d, n)))
    try:
        g1 = d.gate_device_kv(ingress_id="ladder-probe", credential_ref=SUBJ, payload_hash="sha256:" + "0" * 64)
        keep("DOUBLE_INTERLOCK_GATE1_WITHOUT_DESIGNATED_KV_CHAIN", "ALLOW", "observational: gate 1 returned %r" % (g1,))
    except Exception as exc:
        f = getattr(exc, "refusal", None) or getattr(exc, "record", None)
        keep("DOUBLE_INTERLOCK_GATE1_WITHOUT_DESIGNATED_KV_CHAIN", f if isinstance(f, dict) else
             {"disposition": "FAIL_CLOSED", "failure_code": type(exc).__name__ + ":" + str(exc)[:120]})
    print(json.dumps({"rows": rows}, sort_keys=True)); raise SystemExit(0)
_bp = _insp.signature(d.build_chain).parameters
keep("DOUBLE_INTERLOCK_BUILD_CHAIN_ACCEPTS_CALLER_LAYER_RECEIPTS",
     "ACCEPTS" if "kv_access_receipt" in _bp else "NOT_A_PARAMETER",
     "build_chain parameters: " + ", ".join(_bp))
try:
    if "kv_access_receipt" in _bp:
        ch = d.build_chain(ingress_id="ladder-probe", credential_ref=SUBJ, payload_hash="sha256:" + "0" * 64,
                           kv_access_receipt=L1, skap_access_receipt=l2(L1["receipt_hash"]))
    else:  # the layer receipts can only come from the designated ledgers; production designates none
        ch = d.build_chain(ingress_id="ladder-probe", credential_ref=SUBJ, payload_hash="sha256:" + "0" * 64)
    d.validate_chain(ch)
    keep("DOUBLE_INTERLOCK_BUILD_AND_VALIDATE_ON_CALLER_MINTED_LAYERS", "ALLOW",
         "observational: TVC#538/#541 build_chain mints both hops in one call and accepts self-hashed layer receipts")
except Exception as exc:
    f = getattr(exc, "refusal", None) or getattr(exc, "record", None)
    keep("DOUBLE_INTERLOCK_BUILD_AND_VALIDATE_ON_CALLER_MINTED_LAYERS", f if isinstance(f, dict) else
         {"disposition": "FAIL_CLOSED", "failure_code": type(exc).__name__ + ":" + str(exc)[:120]})
print(json.dumps({"rows": rows}, sort_keys=True))
 {root:tvc537}
