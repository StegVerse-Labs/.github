$ {python} -c # P1 rev 11 probe (current-head rows added in rev 14; rev 15: every E0 read runs with the Org side recording each head of its chain (LC-KV-26 both ends), plus LC-KV-26 rows): continuity-vault-kit#263 (head given by the plan) KV / SKAP Vault recorded receipt chains on the storage endpoint.
# Production rows read the committed contracts unchanged; E0 rows reuse Lane D's own TEST-ONLY harness
# (tests/test_kv_ladder_conformance_lc_kv.py kv_chain_e0 / e0_kv_root / e0_kv_attestation), in memory only.
import base64, contextlib, io, json, os, sys, tempfile
WM = lambda x: {"source": "KV_RECORDED_RECEIPT_CHAIN_HEAD", "head_receipt_sha256": x}
from pathlib import Path
sys.path[:0] = [".", "tests"]
import test_kv_ladder_conformance_lc_kv as T
from runtime import kv_receipt_ledgers as rl
# rev 15 (LC-KV-26, continuity-vault-kit#275): the Org side records every head of the E0 chain, so a read-back head
# is held at both ends; the LC-KV-26 rows below withhold or narrow that record.
BE = lambda which, chain: T.both_ends(which, *[c["receipt_sha256"] for c in chain])
SIX = ("failure_code", "failed_predicate", "required_evidence_or_repair", "retry_entrypoint", "owning_existing_goal", "next_attempt")
rows = []
def row(subject, out, note=None, **extra):
    r = {"subject": subject}
    if isinstance(out, dict):
        r["disposition"] = out.get("disposition")
        for k in SIX + ("failure_class",):
            if isinstance(out.get(k), str):
                r[k] = out[k]
    else:
        r["disposition"] = out
    if note: r["note"] = note
    r.update(extra)
    rows.append(r)
def guard(subject, fn, note=None):
    try:
        out = fn()
        row(subject, out, note)
    except Exception as exc:
        rows.append({"subject": subject, "disposition": "EXCEPTION", "exception": type(exc).__name__, "message": str(exc)[:300]})
T.setUpModule()
try:
    # --- production (committed contracts, nothing patched)
    for which in ("kv", "skap_vault"):
        d, ref = rl.designation(which)
        if ref:
            row("PROD_DESIGNATION_" + which.upper(), ref)
        else:
            row("PROD_DESIGNATION_" + which.upper(), "DESIGNATED", note="informational", location=d["location"],
                store_type=d["store"]["store_type"], provider_id=d["store"]["provider_id"], store_location=d["store_location"],
                rollback_watermark_source=d["ledger_designation"]["rollback_watermark_source"])
        c = json.loads((T.ROOT / rl.RECEIPT_LEDGERS[which]["contract_path"]).read_text())
        m = rl._org_membership(c)
        row("PROD_ORG_MEMBERSHIP_" + which.upper(), "ALLOW" if m is None else "FAIL_CLOSED",
            note="committed contract: no org repository, org ref, membership, team or app-installation binding" if m is None else m)
        org = rl._org_designation(c)
        row("PROD_NO_ORG_LEDGER_REF_" + which.upper(), "ALLOW" if org is None else "FAIL_CLOSED",
            note="no org ledger ref / git-ref store in the committed contract" if org is None else org)
    row("PROD_READ_KV", rl.read_receipt_ledger("kv"))
    row("PROD_READ_SKAP_DIRECT", rl.read_receipt_ledger("skap_vault"))
    for p in rl.receipt_ledger_prerequisites():
        row("PROD_PREREQUISITES_" + p["receipt_ledger"].upper(), {k: p.get(k) for k in ("disposition",) + SIX + ("failure_class",)},
            note="informational", codes=[(b["failure_code"], b["failure_class"]) for b in p.get("fail_closed", [])])
    # --- org membership forms (Lane D's harness, genesis pinned so only the membership check can refuse)
    def forms():
        return {
         "ORG_REPOSITORY": lambda c: c["repository_ledger_location"].__setitem__("repository", "StegVerse-org/LLM-adapter"),
         "ORG_REF": lambda c: c["repository_ledger_location"].__setitem__("ref", "refs/heads/main"),
         "ORG_LEDGER_REF": lambda c: c["repository_ledger_location"].__setitem__("ref", "refs/stegverse/organization-ledger"),
         "TEAM_IN_DESIGNATION": lambda c: c["ledger_designation"].__setitem__("team_slug", "kv-endpoints"),
         "APP_INSTALLATION_IN_STORE": lambda c: c["ledger_designation"]["stores"][0].__setitem__("installation_id", 1),
         "ORG_MEMBERSHIP_TOP_LEVEL": lambda c: c.__setitem__("org_membership", {"org": "StegVerse-org", "role": "member"}),
         "UPPERCASE_KEY_MEMBERS": lambda c: c.__setitem__("Members", ["kv-endpoint"]),
         "TOP_LEVEL_ORGANIZATION_KEY": lambda c: c.__setitem__("organization", "StegVerse-org"),
         "TOP_LEVEL_GITHUB_APP_INSTALLATION_ID": lambda c: c.__setitem__("github_app_installation_id", 139890227),
         "TOP_LEVEL_ORG_PERMISSIONS": lambda c: c.__setitem__("permissions", {"organization_members": "write"}),
         "TOP_LEVEL_OWNER_ORG": lambda c: c.__setitem__("owner", "StegVerse-org"),
         "BINDING_INSIDE_DESIGNATION_NOTES": lambda c: c["designation_notes"].__setitem__("team", "kv-endpoints"),
         "NESTED_WATERMARK_SOURCE_ORGANIZATION": lambda c: c["ledger_designation"]["rollback_watermark_source"].__setitem__("organization", "StegVerse-org"),
         "NESTED_LOCATION_OWNER": lambda c: c["repository_ledger_location"].__setitem__("owner", "StegVerse-org"),
         "NESTED_STORE_PERMISSIONS": lambda c: c["ledger_designation"]["stores"][0].__setitem__("permissions", ["read"]),
         "NESTED_DICT_UNDER_A_LEAF": lambda c: c.__setitem__("authority_effect", {"github_app_installation_id": 1}),
         "NESTED_DICT_IN_LIST_LEAF": lambda c: c.__setitem__("required_fields", [{"org_member": True}]),
         "CASING_ORGANIZATION_UPPER": lambda c: c.__setitem__("ORGANIZATION", "StegVerse-org"),
         "CASING_CAMEL_GITHUBAPPINSTALLATIONID": lambda c: c.__setitem__("GitHubAppInstallationId", 1),
         "CASING_INSTALLATIONID": lambda c: c["ledger_designation"].__setitem__("installationID", 1),
         "ALIAS_ORG_DASH_MEMBER": lambda c: c.__setitem__("org-member", True),
         "ALIAS_SPACE_ORG_ROLE": lambda c: c.__setitem__("Org Role", "member"),
         "ALIAS_GH_APP_ID": lambda c: c.__setitem__("gh_app_id", 1),
         "ALIAS_CONCATENATED_ORGMEMBER": lambda c: c.__setitem__("orgmember", True),
         "ALIAS_TENANT": lambda c: c.__setitem__("tenant", "StegVerse-org"),
         "ALIAS_HOMOGLYPH_CYRILLIC_ORG": lambda c: c.__setitem__("\u043erganization", "StegVerse-org"),
         "ALLOWED_KEY_WRONG_CASE_REPOSITORY": lambda c: c["repository_ledger_location"].__setitem__("Repository", "StegVerse-org/.github"),
         "UNKNOWN_KEY_RETENTION_DAYS": lambda c: c.__setitem__("retention_days", 30),
         "WATERMARK_SOURCE_VALUE_ORG_LINKED": lambda c: c["ledger_designation"]["rollback_watermark_source"].__setitem__("source", "ORG_LEDGER_LINKED_RECEIPTS_ENDPOINT_HEAD"),
         "WATERMARK_SOURCE_VALUE_OTHER": lambda c: c["ledger_designation"]["rollback_watermark_source"].__setitem__("source", "CALLER_SUPPLIED_HEAD"),
        }
    for which in ("kv", "skap_vault"):
        for name, edit in forms().items():
            def run(which=which, edit=edit):
                root, chain = T.e0_kv_root(which)
                with T.kv_chain_e0(which, chain[-1]["receipt_sha256"]), BE(which, chain):
                    att = T.e0_kv_attestation(which, chain)   # genuine attestation, made before the edit
                with T.kv_chain_e0(which, chain[-1]["receipt_sha256"], edit), BE(which, chain):
                    if which == "kv":
                        return rl.read_receipt_ledger("kv", T.device_local(), root, att, WM(chain[0]["receipt_sha256"]))
                    layers = T.TwoLayers()
                    return layers.gate.receipt_ledger(layers.kv_hash(), T.device_local(), root, att, WM(chain[0]["receipt_sha256"]))
            guard("MEMBERSHIP_%s_%s" % (name, which.upper()), run)
    # --- E0 positive controls (Lane D's claim: skap_vault reads back to ALLOW at E0 through SkapLayer2Gate)
    carried = "sha256:" + "ab" * 32
    def kv_ok():
        root, chain = T.e0_kv_root("kv", (carried,))
        with T.kv_chain_e0("kv", chain[-1]["receipt_sha256"]), BE("kv", chain):
            return rl.read_receipt_ledger("kv", T.device_local(), root, T.e0_kv_attestation("kv", chain), WM(chain[0]["receipt_sha256"]))
    guard("E0_KV_READ_BACK_WITH_WATERMARK", kv_ok)
    def skap_ok():
        root, chain = T.e0_kv_root("skap_vault", (carried,))
        with T.kv_chain_e0("skap_vault", chain[-1]["receipt_sha256"]), BE("skap_vault", chain):
            layers = T.TwoLayers()
            return layers.gate.receipt_ledger(layers.kv_hash(), T.device_local(), root, T.e0_kv_attestation("skap_vault", chain), WM(chain[0]["receipt_sha256"]))
    guard("E0_SKAP_READ_BACK_VIA_SKAPLAYER2GATE", skap_ok)
    # --- forged carriers and replays
    def forged_sig():
        root, chain = T.e0_kv_root("kv", (carried,))
        with T.kv_chain_e0("kv", chain[-1]["receipt_sha256"]), BE("kv", chain):
            att = dict(T.e0_kv_attestation("kv", chain))
            from kv_two_layer_e0 import signer
            d = rl.designation("kv")[0]
            body = {k: att[k] for k in rl.HEAD_ATTESTATION_FIELDS}
            msg = rl.HEAD_ATTESTATION_SCHEMA.encode() + b"\n" + T.pinned()["healthy_node_evaluator"].canon(body)
            att["signature_b64"] = signer().sign_b64(msg, b"\x07" * 32)
            return rl.read_receipt_ledger("kv", T.device_local(), root, att, WM(chain[0]["receipt_sha256"]))
    guard("FORGED_HEAD_SIGNATURE_CALLER_SEED", forged_sig)
    def other_endpoint():
        root, chain = T.e0_kv_root("kv", (carried,))
        with T.kv_chain_e0("kv", chain[-1]["receipt_sha256"]), BE("kv", chain):
            att = T.e0_kv_attestation("kv", chain, endpoint_id="STEGVERSE_KV:_Vault/SKAP/Receipts")
            return rl.read_receipt_ledger("kv", T.device_local(), root, att, WM(chain[0]["receipt_sha256"]))
    guard("FORGED_ATTESTATION_NAMES_THE_SKAP_CHAIN", other_endpoint)
    def foreign():
        root, chain = T.e0_kv_root("kv", (carried,), repository="StegVerse-org/.github")
        with T.kv_chain_e0("kv", chain[-1]["receipt_sha256"]), BE("kv", chain):
            return rl.read_receipt_ledger("kv", T.device_local(), root, None, None)
    guard("ORG_LEDGER_RECEIPTS_PRESENTED_AS_KV_CHAIN", foreign)
    def stray():
        root, chain = T.e0_kv_root("kv", (carried,))
        (root / "_StegVerse/Receipts/receipts/1DriveFileId.json").write_text(json.dumps({"kind": "drive#file"}))
        with T.kv_chain_e0("kv", chain[-1]["receipt_sha256"]), BE("kv", chain):
            return rl.read_receipt_ledger("kv", T.device_local(), root, T.e0_kv_attestation("kv", chain), WM(chain[0]["receipt_sha256"]))
    guard("PROVIDER_RECORD_IN_CHAIN_LOCATION", stray)
    def rolled_back(which, watermark):
        root, chain = T.e0_kv_root(which, (carried, "sha256:" + "cd" * 32))
        where = root / rl.RECEIPT_LEDGERS[which]["storage_location"]
        (where / "receipts" / (chain[0]["receipt_sha256"][7:] + ".json")).unlink()
        (where / "HEAD.json").write_text(json.dumps({"receipt_sha256": chain[1]["receipt_sha256"]}))
        old = chain[1:]
        with T.kv_chain_e0(which, chain[-1]["receipt_sha256"]), BE(which, chain):
            att = T.e0_kv_attestation(which, old)   # a genuine signed head, one receipt older than the newest
            rec = WM(chain[0]["receipt_sha256"]) if watermark else None
            if which == "kv":
                return rl.read_receipt_ledger("kv", T.device_local(), root, att, rec)
            layers = T.TwoLayers()
            return layers.gate.receipt_ledger(layers.kv_hash(), T.device_local(), root, att, rec)
    def rolled_back_wm(which, wm):
        root, chain = T.e0_kv_root(which, (carried, "sha256:" + "cd" * 32))
        where = root / rl.RECEIPT_LEDGERS[which]["storage_location"]
        (where / "receipts" / (chain[0]["receipt_sha256"][7:] + ".json")).unlink()
        (where / "HEAD.json").write_text(json.dumps({"receipt_sha256": chain[1]["receipt_sha256"]}))
        old = chain[1:]
        rec = {"NONE": None, "KV_OWN_NEWEST": WM(chain[0]["receipt_sha256"]), "REGRESSED_TO_PRESENTED_HEAD": WM(chain[1]["receipt_sha256"]),
               "BARE_STRING_NEWEST": chain[0]["receipt_sha256"], "MALFORMED_SHORT": WM("77"),
               "MALFORMED_UPPERCASE": WM(chain[0]["receipt_sha256"].upper().replace("SHA256:", "sha256:")),
               "FOREIGN_DIGEST": WM("sha256:" + "ee" * 32),
               "ORG_SOURCED": {"source": "ORG_LEDGER_LINKED_RECEIPTS_ENDPOINT_HEAD", "head_receipt_sha256": chain[0]["receipt_sha256"]},
               "ORG_CROSS_CHECK_NEWEST_WITH_REGRESSED_HEAD": dict(WM(chain[1]["receipt_sha256"]), org_crossing_cross_check=chain[0]["receipt_sha256"]),
               "EXTRA_KEY": dict(WM(chain[0]["receipt_sha256"]), organization="StegVerse-org")}[wm]
        with T.kv_chain_e0(which, chain[-1]["receipt_sha256"]), BE(which, chain):
            att = T.e0_kv_attestation(which, old)   # a genuine signed head, one receipt older than the newest
            if which == "kv":
                return rl.read_receipt_ledger("kv", T.device_local(), root, att, rec)
            layers = T.TwoLayers()
            return layers.gate.receipt_ledger(layers.kv_hash(), T.device_local(), root, att, rec)
    for which, tag in (("kv", "KV"), ("skap_vault", "SKAP_VIA_GATE")):
        for wm in ("NONE", "KV_OWN_NEWEST", "BARE_STRING_NEWEST", "MALFORMED_SHORT", "MALFORMED_UPPERCASE", "FOREIGN_DIGEST", "ORG_SOURCED", "EXTRA_KEY"):
            guard("REPLAY_OLDER_SIGNED_HEAD_WATERMARK_%s_%s" % (wm, tag), lambda which=which, wm=wm: rolled_back_wm(which, wm))
        guard("REPLAY_OLDER_SIGNED_HEAD_WATERMARK_REGRESSED_TO_PRESENTED_HEAD_%s" % tag,
              lambda which=which: rolled_back_wm(which, "REGRESSED_TO_PRESENTED_HEAD"),
              note="the watermark is a caller-supplied mapping {source KV_RECORDED_RECEIPT_CHAIN_HEAD, head_receipt_sha256}; a caller that regresses it to the older head it presents is not refused: nothing ties head_receipt_sha256 to a record the rollback cannot reach")
        guard("REPLAY_OLDER_SIGNED_HEAD_WATERMARK_ORG_CROSS_CHECK_NEWEST_WITH_REGRESSED_HEAD_%s" % tag,
              lambda which=which: rolled_back_wm(which, "ORG_CROSS_CHECK_NEWEST_WITH_REGRESSED_HEAD"),
              note="the digest-only org_crossing_cross_check names the newest head while head_receipt_sha256 regresses: the cross-check is never compared (authority NONE)")
    def positive_no_wm(which):
        root, chain = T.e0_kv_root(which, (carried,))
        with T.kv_chain_e0(which, chain[-1]["receipt_sha256"]), BE(which, chain):
            if which == "kv":
                return rl.read_receipt_ledger("kv", T.device_local(), root, T.e0_kv_attestation("kv", chain), None)
            layers = T.TwoLayers()
            return layers.gate.receipt_ledger(layers.kv_hash(), T.device_local(), root, T.e0_kv_attestation(which, chain), None)
    guard("CURRENT_HEAD_WITHOUT_WATERMARK_KV", lambda: positive_no_wm("kv"))
    guard("CURRENT_HEAD_WITHOUT_WATERMARK_SKAP_VIA_GATE", lambda: positive_no_wm("skap_vault"))
    # rev 14 (Coordination C-review ruling (A), #167 c6392982821): KV's own head record is the authority; the caller's
    # watermark is an optional claim. Current-head rows keep the claim's validation witnessed.
    def current_head(which, wm):
        root, chain = T.e0_kv_root(which, (carried,))
        head = chain[0]["receipt_sha256"]
        rec = {"MATCHED": WM(head), "BARE_STRING": head, "MALFORMED_SHORT": WM("77"),
               "MALFORMED_UPPERCASE": WM(head.upper().replace("SHA256:", "sha256:")),
               "EXTRA_KEY": dict(WM(head), organization="StegVerse-org"),
               "ORG_SOURCED": {"source": "ORG_LEDGER_LINKED_RECEIPTS_ENDPOINT_HEAD", "head_receipt_sha256": head},
               "FOREIGN_DIGEST": WM("sha256:" + "ee" * 32), "HEAD_RECORD_ABSENT": None}[wm]
        if wm == "HEAD_RECORD_ABSENT":
            (root / rl.RECEIPT_LEDGERS[which]["storage_location"] / rl.HEAD_RECORD).unlink()
        with T.kv_chain_e0(which, chain[-1]["receipt_sha256"]), BE(which, chain):
            att = T.e0_kv_attestation(which, chain)
            if which == "kv":
                return rl.read_receipt_ledger("kv", T.device_local(), root, att, rec)
            layers = T.TwoLayers()
            return layers.gate.receipt_ledger(layers.kv_hash(), T.device_local(), root, att, rec)
    for which, tag in (("kv", "KV"), ("skap_vault", "SKAP_VIA_GATE")):
        for wm in ("BARE_STRING", "MALFORMED_SHORT", "MALFORMED_UPPERCASE", "EXTRA_KEY", "ORG_SOURCED", "FOREIGN_DIGEST", "MATCHED"):
            guard("CURRENT_HEAD_WATERMARK_%s_%s" % (wm, tag), lambda which=which, wm=wm: current_head(which, wm))
        guard("CURRENT_HEAD_HEAD_RECORD_ABSENT_%s" % tag, lambda which=which: current_head(which, "HEAD_RECORD_ABSENT"))
    # rev 15: LC-KV-26 (Coordination 05:03Z via StegVerse-org/.github#167 c6393119202: "a crossing record held at both
    # ends (the org side and KV's own ledger), never an InTr hop inside one org"), closed by continuity-vault-kit#275
    def both_ends_case(which, case):
        root, chain = T.e0_kv_root(which, (carried, "sha256:" + "cd" * 32))
        heads = [c["receipt_sha256"] for c in chain]
        org = {"KV_END_ONLY": None, "ORG_RECORDS_AN_OLDER_HEAD_ONLY": heads[1:], "ORG_RECORDS_EVERY_HEAD": heads,
               "ROLLBACK_AFTER_LAST_CROSSING": heads}[case]
        present = chain
        if case == "ROLLBACK_AFTER_LAST_CROSSING":
            where = root / rl.RECEIPT_LEDGERS[which]["storage_location"]
            (where / "receipts" / (heads[0][7:] + ".json")).unlink()
            (where / "HEAD.json").write_text(json.dumps({"receipt_sha256": heads[1]}))
            present = chain[1:]
        side = T.org_side(None) if org is None else T.both_ends(which, *org)
        with T.kv_chain_e0(which, chain[-1]["receipt_sha256"]), side:
            att = T.e0_kv_attestation(which, present)
            if which == "kv":
                return rl.read_receipt_ledger("kv", T.device_local(), root, att, None)
            layers = T.TwoLayers()
            return layers.gate.receipt_ledger(layers.kv_hash(), T.device_local(), root, att, None)
    for which, tag in (("kv", "KV"), ("skap_vault", "SKAP_VIA_GATE")):
        for case in ("KV_END_ONLY", "ORG_RECORDS_AN_OLDER_HEAD_ONLY", "ORG_RECORDS_EVERY_HEAD", "ROLLBACK_AFTER_LAST_CROSSING"):
            guard("LC_KV_26_BOTH_ENDS_%s_%s" % (case, tag), lambda which=which, case=case: both_ends_case(which, case))
    def forged_layer1():
        root, chain = T.e0_kv_root("skap_vault", (carried,))
        with T.kv_chain_e0("skap_vault", chain[-1]["receipt_sha256"]), BE("skap_vault", chain):
            layers = T.TwoLayers()
            return layers.gate.receipt_ledger("sha256:" + "11" * 32, T.device_local(), root, T.e0_kv_attestation("skap_vault", chain), WM(chain[0]["receipt_sha256"]))
    guard("SKAP_READ_ON_A_NEVER_MINTED_LAYER1_HASH", forged_layer1)
    def clock_obs():
        root, chain = T.e0_kv_root("kv", (carried,))
        with T.kv_chain_e0("kv", chain[-1]["receipt_sha256"]), BE("kv", chain):
            out = rl.read_receipt_ledger("kv", T.device_local(), root, T.e0_kv_attestation("kv", chain), WM(chain[0]["receipt_sha256"]))
        return out
    o = None
    try:
        o = clock_obs()
    except Exception as exc:
        o = {"disposition": "EXCEPTION"}
    row("KV_CHAIN_RECEIPT_OBSERVED_AT_CLOCK_STAMP_ACCEPTED", o.get("disposition"), note="informational: Lane D's E0 receipts carry observed_at '2026-10-23T12:00:00Z' (a clock stamp); runtime/kv_receipt_ledgers.py never checks observed_at, so nothing binds it to SUPPLIED_HB_EPOCH")
finally:
    T.tearDownModule()
print(json.dumps({"rows": rows}, sort_keys=True))

