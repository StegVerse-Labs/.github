      "ordered_prerequisite": "AUTHENTICATED_RECIPROCAL_NODE_EXISTENCE -> NODE_IDENTITY_BINDING -> CURRENT_NODE_HEALTH -> REQUESTER_IS_CURRENTLY_ADMITTED_HEALTHY_NODE -> MANIFEST_BOUND_REQUEST_AUTHORIZATION",
      "first_external_target": "Richard-operated Sebbi.Pro Node",
