      "predecessor_state",
      "predecessor_head_sha",
      "required_exact_head_check_conclusions",
      "merge_or_supersession_evidence"
    ],
    "enforcement_boundary": "Every PR-creating caller must invoke/adopt this gate before GitHub PR mutation; policy text alone does not intercept repository-local callers.",
    "known_unadopted_callers": [
