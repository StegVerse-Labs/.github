{
  "schema": "stegverse.reusable-task-component-model/v1",
  "name": "Reusable Task Component Model",
  "purpose": "Allow canonical Goal Tasks to declare required capabilities and deterministically compose reusable, authority-preserving task components instead of embedding large task-specific orchestration chains.",
  "component_families": {
    "transport": "data/reusable-transport-component-contract.json",
    "sovereign_source_refresh": "data/reusable-sovereign-source-refresh-component-contract.json",
    "runtime_observation": "CANONICAL_EXISTING_OWNER",
    "governed_ingress": "CANONICAL_EXISTING_OWNER",
    "ai_ingress_coordination": "data/reusable-ai-ingress-component-contract.json",
    "execution_materialization": "data/reusable-task-ephemeral-construct-contract.json",
    "credential_session": "CANONICAL_EXISTING_OWNER",
    "evidence_validation": "data/reusable-evidence-validation-component-contract.json",
    "custody_reconstruction": "CANONICAL_EXISTING_OWNER",
    "framework_provider_adapter": "TASK_SPECIFIC_TRANSLATOR_PLUS_REUSABLE_PROTOCOL_COMPONENT",
    "callback_correlation": "REUSABLE_COMPONENT_CANDIDATE",
    "release_propagation": "data/reusable-publisher-kv-completion-notification-component-contract.json",
    "failure_remediation_classification": "REUSABLE_COMPONENT_CANDIDATE",
    "terminal_cleanup_entropy_recovery": "data/reusable-task-ephemeral-construct-contract.json"
  },
  "goal_task_contract": {
    "goal_task_declares_requirements": true,
    "composition_is_derived": true,
    "component_order_is_governed": true,
    "components_may_repeat": true,
    "components_may_be_optional": true,
    "unused_components_must_not_be_forced": true,
    "missing_required_component": "FAIL_CLOSED",
    "component_reuse_mints_authority": false
  },
  "component_interface_minimum": [
    "component_id",
    "capability_provided",
    "inputs",
    "outputs",
    "preconditions",
    "expected_evidence",
    "authority_owner",
    "authority_effect",
    "failure_classes",
    "retry_or_reentry_semantics",
    "version_or_schema_binding"
  ],
  "composition_invariants": {
    "task_registry": "COORDINATION_ONLY",
    "worker_claim_fence": "WorkerCoordinator",
    "user_verification": "KV/SKAP Vault",
    "stegos_device_role": "INTERCHANGEABLE_ACCESS_AND_TRANSPORT_ENDPOINT",
    "specific_device_identity_continuity_authority": "NONE",
    "specific_device_identity_runtime_completion_authority": "NONE",
    "specific_os_browser_local_state_continuity_authority": "NONE",
    "kv_provider_access": "PROVIDER_NEUTRAL_AND_DEVICE_INDEPENDENT",
    "replacement_device_reconstruction": "REQUIRED_FROM_KV_PLUS_CANONICAL_RETAINED_EVIDENCE",
    "legacy_current_iphone_same_device_labels": "NON_NORMATIVE_IMPLEMENTATION_OR_HISTORICAL_LABELS_ONLY",
    "credential_provider_release": "TV/TVC",
    "governed_transition": "Interlock/InTr",
    "observed_reality_custody_reconstruction": "Master Records",
    "heartbeat": "TIMING_FRESHNESS_CORRELATION_CARRIAGE_ONLY",
    "github_runtime_authority": "NONE"
  },
  "anti_patterns": [
    "goal_task_reimplements_existing_component",
    "component_combines_multiple_independent_authority_owners_without_explicit_interfaces",
    "component_receipt_treated_as_authority_for_later_component",
    "task_specific_adapter_duplicates_generic_transport",
    "one_component_becomes_permanent_scheduler_or_hidden_runtime",
    "device_or_transport_identity_becomes_user_verifier",
    "specific_user_device_becomes_continuity_root",
    "specific_user_device_becomes_runtime_completion_prerequisite",
    "specific_os_or_browser_state_becomes_required_continuation_state",
    "provider_identity_is_coupled_to_client_device_identity",
    "same_device_instruction_is_used_as_architectural_requirement",
    "legacy_current_iphone_symbol_is_reinterpreted_as_current_architecture",
    "optional_component_is_forced_into_unrelated_tasks"
  ]
}
