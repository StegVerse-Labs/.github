{
  "schema": "stegverse.heartbeat-runtime-separation-contract/v2",
  "goal_id": "HEARTBEAT-CARRIER-RUNTIME-SEPARATION-122",
  "carrier_role": "REGULATORY_CARRIER_REFERENCE_FRAME",
  "control_plane_role": "WORKER_AND_DOMAIN_COORDINATION",
  "nervous_system_owner": "StegVerse-Labs/StegBrain#860",
  "master_records_role": "PASSIVE_CUSTODY_AND_QUERYABLE_EVIDENCE",
  "required_domains": ["StegVerse-Labs", "DEMO", "TEST", "StegVerse-org", "StegGhost"],
  "carrier_oscillator": {
    "mechanism": "INDEPENDENT_PHASE_OSCILLATOR",
    "phase_travel_time_ms": 10,
    "reference_increment_interval_ms": 10,
    "reference_frequency_hz": 100,
    "progression_dependency": "OSCILLATOR_ONLY",
    "worker_or_task_gating": false,
    "admission_gating": false,
    "claim_or_fence_gating": false,
    "route_or_credential_gating": false,
    "observation_is_causal": false,
    "persisted_state_is_sample_only": true,
    "missed_references_are_permitted": true,
    "consumer_may_delay_carrier": false,
    "consumer_may_advance_carrier": false
  },
  "carrier_envelope": {
    "schema_ref": "schemas/heartbeat-carrier-envelope.schema.json",
    "calculator_ref": "heartbeat_runtime/carrier_envelope.py",
    "frequency_rule": "INDEPENDENT_OSCILLATOR_10MS_PHASE_TRAVEL",
    "fixed_reference_interval_ms": 10,
    "phase_rule": "OSCILLATOR_PHASE_TRAVEL",
    "alternate_phase_grants_execution_authority": false,
    "deviation_observability": ["FREQUENCY_DEVIATION", "PHASE_DEVIATION", "JITTER_DEVIATION"],
    "growth_aware_capacity_is_separate_from_carrier_progression": true
  },
  "reference_snapshot_monitoring": {
    "schema_ref": "schemas/heartbeat-reference-snapshot.schema.json",
    "implementation_ref": "heartbeat_runtime/reference_snapshot.py",
    "policy_ref": "control/heartbeat-reference-snapshot-policy.json",
    "latest_snapshot_ref": "control/heartbeat-reference-snapshot.json",
    "history_ref": "receipts/heartbeat-reference-snapshots/",
    "reacquisition_rule": "GATE_PASSBAND_DERIVED",
    "meaning": "GATE_PASSBAND_DERIVED applies to non-authorizing reference-snapshot reacquisition for completion monitoring, never to carrier progression.",
    "gate": "the evidenced set of required states for the monitored goal; OPEN while any required state is pending and CLOSED only when all are complete",
    "passband": "the configured carrier-reference delta after which unresolved state must be re-observed even when no required-state value has changed",
    "reacquire_when": ["INITIAL", "REQUIRED_STATE_CHANGED", "PASSBAND_CROSSED", "TERMINAL_GATE_CLOSED", "REFERENCE_REPAIR"],
    "reacquire_on_state_change_inside_passband": true,
    "stop_periodic_reacquisition_when_gate_closed": true,
    "snapshot_is_observation_only": true,
    "snapshot_controls_carrier_progression": false,
    "snapshot_grants_execution_authority": false,
    "snapshot_grants_claim_or_fence_authority": false,
    "historical_carrier_state_may_be_observed_without_rewrite": true
  },
  "forbidden_carrier_fields": ["claim_id", "fencing_token", "active_leases", "lease_action", "worker_registry_ref", "master_records_projection", "route", "credential", "execution_authority"],
  "authority": {
    "heartbeat_grants_execution_authority": false,
    "signal_grants_execution_authority": false,
    "master_records_action_authority": false,
    "credential_authority": "TV/TVC",
    "github_token_runtime_authority": false,
    "non_tv_tvc_secret_or_token_required": false
  },
  "compatibility": {
    "legacy_schema": "stegverse.heartbeat-subsignals/v1",
    "legacy_schema_is_historical_provenance": true,
    "live_state_mutation_by_projection": false,
    "pre_v2_frequency_rule": "GATE_PASSBAND_DERIVED",
    "pre_v2_frequency_rule_superseded_for_carrier_progression": true,
    "pre_v2_frequency_rule_retained_for_reference_snapshot_reacquisition": true,
    "capacity_envelope_may_not_gate_oscillator": true
  }
}
