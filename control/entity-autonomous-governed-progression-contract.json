      "cosv_task_vectors": true,
      "mirror_handoffs": true,
      "completion_states": true,
      "dependencies": true,
      "adjacent_tasks": true,
      "integration_candidates": true,
      "evidence_and_receipts": true
    },
    "returned_task_id_is_not_automatically_new_work": true,
    "continuity_resolution_order": [
      "MATCH_TASK_ID_AGAINST_CANONICAL_ACTIVE_AND_COMPLETED_WORK",
      "VERIFY_TASK_ID_COSV_VECTOR_BINDING_WHEN_PRESENT",
      "RESOLVE_APPLICABLE_MIRROR_HANDOFFS",
      "RECONCILE_MASTER_RECORDS_EVIDENCE",
      "RESOLVE_WORKERCOORDINATOR_CLAIM_FENCE",
      "CLASSIFY_AS_CONTINUATION_SUCCESSOR_DEPENDENCY_ADJACENT_OR_NEW",
      "DEDUPLICATE_EQUIVALENT_WORK",
      "RESOLVE_REPOSITORY_RUNTIME_AUTHORITY_AND_EVIDENCE_COLLISIONS",
      "REGROUP_PARALLEL_CAPABLE_WORK",
      "SELECT_NEXT_ADMISSIBLE_NON_DUPLICATE_WORK"
