    "intermediate_state_is_internal_orchestration": [
      "UNCHANGED_TASK_ID",
      "SUCCESSOR_TASK_ID",
      "UPDATED_COSV_TASK_VECTOR",
      "NEW_MIRROR_HANDOFF",
      "VALIDATION_FAILURE_WITH_ADMISSIBLE_REPAIR",
      "NEW_DEPENDENCY",
      "NEW_ADJACENT_TASK",
      "NEW_INTEGRATION_CANDIDATE"
    ],
    "periodic_report_does_not_stop_machine_owned_work": true,
    "no_second_scheduler_or_coordinator": true,
    "evaluator_ref": "scripts/evaluate_goal_resolution_continuation.py"
  },
  "human_authority_classes": [
