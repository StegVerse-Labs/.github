{
  "schema": "stegverse.canonical-policy-context-registry/v1",
  "status": "ACTIVE_SOURCE_POLICY_CONTEXT",
  "canonical_owner_task": "STEGVERSE-CANONICAL-WORK-COORDINATION-001",
  "authority_effect": "NONE_PREWORK_INTERPRETATION_ONLY",
  "purpose": "Require every StegVerse session/build/task-interpretation ingress to resolve already-canonical architecture and lifecycle semantics before interpreting task state, deriving a blocker, proposing remediation, creating new work, or mutating source.",
  "ingress_scope": {
    "applies_to": [
      "NEW_SESSION_ENTRY",
      "TASK_OR_COSV_CONTINUATION",
      "BUILD_OR_IMPLEMENTATION_PREWORK",
      "HANDOFF_RECONCILIATION",
      "REMEDIATION_PROPOSAL",
      "SOURCE_MUTATION_PROPOSAL",
      "REUSABLE_COMPONENT_DECOMPOSITION"
    ],
    "must_resolve_before_local_interpretation": true,
    "must_resolve_before_source_mutation": true,
    "must_resolve_before_new_task_or_component_creation": true,
    "runtime_packet_validation_authority_changed": false,
    "interlock_intr_authority_changed": false
  },
  "required_global_sources": [
    {
      "ref": "data/task-coordination-policy.json",
      "required": true,
      "purpose": "Canonical task lifecycle, ephemeral-runner, authority, continuity, Master Records, and session-continuation invariants."
    },
    {
      "ref": "docs/CROSS_TASK_COORDINATION_MIRROR_HANDOFF.md",
      "required": true,
      "purpose": "Canonical cross-task evidence, subject-binding, adjacency, collision, and evidence-gap semantics."
    },
    {
      "ref": "data/reusable-task-component-model.json",
      "required": true,
      "purpose": "Canonical reusable-component composition and authority-separation invariants, including interchangeable StegOS device role and KV/SKAP user-verification ownership."
    },
    {
      "ref": "control/device-replaceability-invariant.json",
      "required": true,
      "purpose": "Globally prohibit specific-device, OS, browser, Safari, service-worker, IndexedDB, or same-device continuity/runtime prerequisites; require provider-neutral KV/MyKV continuity and reconstructible any-device continuation."
    },
    {
      "ref": "docs/DEVICE_REPLACEABILITY_INVARIANT_MIRROR_HANDOFF.md",
      "required": true,
      "purpose": "Human-readable canonical interpretation of the replaceable-device invariant and legacy CURRENT_IPHONE/same-device label handling."
    },
    {
      "ref": "docs/CANONICAL_INVARIANT_INGRESS_LOCK_MIRROR_HANDOFF.md",
      "required": true,
      "purpose": "Mandatory canonical-source-first interpretation lock for every session/build/task interpretation ingress and source-mutation proposal."
    }
  ],
  "task_policy_refs": {
    "canonical_task_record_field": "canonical_policy_refs",
    "handoff_policy_refs_allowed": true,
    "missing_declared_ref_fails_closed": true,
    "undeclared_domain_policy_may_not_be_invented": true
  },
  "session_preflight": {
    "required_before_state_interpretation": true,
    "required_before_blocker_derivation": true,
    "required_before_remediation_proposal": true,
    "required_before_new_task_creation": true,
    "required_before_source_mutation": true,
    "required_before_architecture_reinterpretation": true,
    "required_before_device_or_runtime_substrate_selection": true,
    "required_before_kv_provider_reasoning": true,
    "fail_closed_disposition": "STOP_AT_CANONICAL_POLICY_DEPENDENCY",
    "runtime_truth_inferred": false,
    "execution_authority_inferred": false,
    "transition_authority_inferred": false,
    "credential_authority_inferred": false
  },
  "canonical_invariant_lock": {
    "enabled": true,
    "canonical_source_precedes_local_reasoning": true,
    "task_specific_wording_may_parameterize_but_not_redefine_canonical_invariant": true,
    "task_specific_runtime_subject_does_not_create_new_architectural_role": true,
    "conflicting_local_interpretation_is_invalid": true,
    "existing_canonical_invariant_must_be_reused_not_recreated": true,
    "restatement_of_existing_invariant_is_not_new_work": true,
    "restatement_alone_must_not_create_pr_task_component_handoff_or_policy_artifact": true,
    "new_role_authority_identity_class_or_execution_owner_requires_proof_canonical_model_lacks_equivalent": true,
    "human_correction_matching_existing_canonical_truth_requires_no_source_mutation": true,
    "specific_user_device_may_not_be_promoted_to_continuity_or_runtime_owner": true,
    "legacy_current_iphone_or_same_device_labels_are_non_normative": true,
    "provider_identity_and_device_identity_must_remain_independent": true,
    "failure_disposition": "REUSE_CANONICAL_TRUTH_OR_STOP_AT_EXACT_CANONICAL_DEPENDENCY"
  },
  "interpretation_guards": [
    "CANONICAL_POLICY_CONTEXT_PRECEDES_SESSION_INFERENCE",
    "CANONICAL_SOURCE_PRECEDES_LOCAL_INTERPRETATION",
    "TASK_SPECIFIC_WORDING_MAY_PARAMETERIZE_BUT_NOT_REDEFINE_CANONICAL_INVARIANT",
    "TASK_SPECIFIC_RUNTIME_SUBJECT_DOES_NOT_CREATE_NEW_ARCHITECTURAL_ROLE",
    "CONFLICTING_LOCAL_INTERPRETATION_IS_INVALID",
    "EXISTING_CANONICAL_INVARIANT_MUST_BE_REUSED_NOT_RECREATED",
    "RESTATEMENT_OF_EXISTING_INVARIANT_IS_NOT_NEW_WORK",
    "NO_PR_TASK_COMPONENT_HANDOFF_OR_POLICY_MUTATION_MERELY_TO_RESTATE_EXISTING_CANONICAL_TRUTH",
    "NEW_ROLE_AUTHORITY_IDENTITY_CLASS_OR_EXECUTION_OWNER_REQUIRES_PROOF_CANONICAL_MODEL_LACKS_EQUIVALENT",
    "HUMAN_CORRECTION_MATCHING_EXISTING_CANONICAL_TRUTH_REQUIRES_NO_SOURCE_MUTATION",
    "CANONICALLY_RESOLVABLE_POLICY_MUST_NOT_BE_RETAUGHT_BY_HUMAN_PROMPT",
    "EPHEMERAL_OR_EXPIRING_RUNTIME_STATE_MUST_NOT_BE_RECLASSIFIED_AS_FAILURE_WITHOUT_CANONICAL_LIFECYCLE_EVIDENCE",
    "ABSENCE_STALENESS_EXPIRY_DEVICE_WORKER_HEARTBEAT_AUTHORITY_AND_CUSTODY_TERMS_MUST_USE_CANONICAL_SEMANTICS",
    "MISSING_POLICY_CONTEXT_IS_AN_EXACT_DEPENDENCY_NOT_PERMISSION_TO_INVENT_SEMANTICS",
    "POLICY_CONTEXT_DOES_NOT_PROVE_RUNTIME_TRUTH_OR_GRANT_AUTHORITY",
    "USER_DEVICE_IS_INTERCHANGEABLE_ACCESS_TRANSPORT_ENDPOINT",
    "SPECIFIC_DEVICE_OS_BROWSER_OR_BROWSER_LOCAL_STATE_MUST_NOT_BECOME_CONTINUITY_PREREQUISITE",
    "CURRENT_IPHONE_AND_SAME_DEVICE_LABELS_ARE_NON_NORMATIVE_LEGACY_LABELS_ONLY",
    "KV_PROVIDER_IDENTITY_IS_INDEPENDENT_OF_CLIENT_DEVICE_IDENTITY",
    "REPLACEMENT_DEVICE_CONTINUES_FROM_PROVIDER_NEUTRAL_KV_AND_CANONICAL_RECEIPTS_WITHOUT_REPLAYING_AUTHENTIC_TRANSITIONS"
  ],
  "known_global_invariants_resolved_from_task_coordination_policy": [
    "CANONICALLY_RESOLVABLE_TASK_DOCUMENTATION_IS_NOT_REPEATED_IN_PROMPTS",
    "RUNNERS_EXPIRE_BEFORE_RECORDING_CONTINUITY",
    "EPHEMERAL_CAPABILITY_DOES_NOT_MEAN_EPHEMERAL_ACCOUNTABILITY",
    "TASK_REGISTRY_DOES_NOT_MINT_EXECUTION_AUTHORITY",
    "WORKERCOORDINATOR_OWNS_EXECUTION_CLAIM_AND_FENCE",
    "MASTER_RECORDS_OWNS_OBSERVED_REALITY_AND_RECONSTRUCTION",
    "MISSING_EVIDENCE_IS_NOT_PROOF_OF_NON_OCCURRENCE"
  ],
  "known_global_invariants_resolved_from_reusable_task_component_model": [
    "STEGOS_DEVICE_ROLE_IS_INTERCHANGEABLE_TRANSPORT_NODE",
    "KV_SKAP_VAULT_IS_SOLE_USER_VERIFICATION_AUTHORITY",
    "COMPONENT_REUSE_MINTS_NO_AUTHORITY",
    "UNUSED_COMPONENTS_MUST_NOT_BE_FORCED"
  ],
  "known_global_invariants_resolved_from_device_replaceability": [
    "USER_DEVICE_IS_INTERCHANGEABLE_ACCESS_TRANSPORT_ENDPOINT",
    "NO_SPECIFIC_DEVICE_OS_BROWSER_OR_LOCAL_BROWSER_STATE_MAY_OWN_CONTINUITY",
    "PROVIDER_NEUTRAL_MYKV_CONTINUITY_SURVIVES_DEVICE_REPLACEMENT",
    "CURRENT_IPHONE_AND_SAME_DEVICE_TERMS_ARE_LEGACY_LABELS_NOT_ARCHITECTURAL_REQUIREMENTS",
    "DEVICE_REPLACEMENT_DOES_NOT_INVALIDATE_AUTHENTIC_RETAINED_TRANSITIONS"
  ],
  "nonclaims": [
    "POLICY_CONTEXT_RESOLUTION_DOES_NOT_CREATE_RUNTIME_STATE",
    "POLICY_CONTEXT_RESOLUTION_DOES_NOT_CREATE_OR_RENEW_CLAIMS_OR_FENCES",
    "POLICY_CONTEXT_RESOLUTION_DOES_NOT_AUTHORIZE_INTERLOCK_INTR_TRANSITIONS",
    "POLICY_CONTEXT_RESOLUTION_DOES_NOT_AUTHORIZE_CREDENTIALS_ROUTES_PUBLICATION_OR_CUSTODY"
  ]
}
