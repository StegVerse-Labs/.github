{
  "schema": "stegverse.process-worker-adapter-fragment/v0.1",
  "fragment_id": "SV-DN1-PRODUCTION-SOURCE-PREP-001",
  "adapters": [
    {
      "adapter_ref": "process:sv-dn1-production-source-prep-v1",
      "authority_ref": "handoffs/SV-DN1-PRODUCTION-SOURCE-PREP-001.json#authority",
      "capabilities": [
        "bounded_process_execution",
        "content_addressed_source_package_materialization",
        "exact_source_materialization",
        "local_source_identity_validation",
        "evidence_class_preservation"
      ],
      "command": [
        "python",
        "workers/sv_dn1_production_source_prep_worker.py"
