{
  "schema": "stegverse.test-lanes-autolaunch-matrix/v1",
  "matrix_id": "STEGVERSE-TEST-LANES-AUTOLAUNCH-001",
  "test_id": "SV-COST-NINE-LANE-v1",
  "mode": "CANONICAL_FULL_9_OF_9",
  "wake_sources": [
    "heartbeat_carrier_transition",
    "worker_runtime_transition",
    "tvc_vault_readiness_change",
    "provider_capsule_resolution_change",
    "source_validation_change"
  ],
  "authority": {
    "heartbeat_grants_execution_authority": false,
    "execution_authority": "fresh_bounded_test_run_claim",
    "credential_authority": "TV/TVC",
    "primary_provider": "stegverse_local",
    "third_party_role": "CONTROL_OR_FALLBACK_ONLY",
    "non_tv_tvc_secret_or_token_allowed": false
  },
  "predicates": [
    {"id": "carrier_hb30_plus", "class": "MACHINE_OWNED", "path": "runtime.carrier_epoch", "op": "gte", "value": 30, "required": true},
    {"id": "worker_observed_carrier", "class": "MACHINE_OWNED", "path": "runtime.worker_observed_current_carrier", "op": "eq", "value": true, "required": true},
    {"id": "state_reconstruction_pass", "class": "REQUIRED", "path": "runtime.state_reconstruction_pass", "op": "eq", "value": true, "required": true},
    {"id": "sovereign_same_execution_activation", "class": "MACHINE_OWNED", "path": "sovereign.same_execution_activation", "op": "eq", "value": true, "required": true},
    {"id": "primary_endpoint_ready", "class": "REQUIRED", "path": "sovereign.primary_endpoint_ready", "op": "eq", "value": true, "required": true},
    {"id": "primary_model_verified", "class": "REQUIRED", "path": "sovereign.model_verified", "op": "eq", "value": true, "required": true},
    {"id": "primary_credential_none", "class": "REQUIRED", "path": "sovereign.credential_requirement", "op": "eq", "value": "NONE", "required": true},
    {"id": "primary_no_third_party", "class": "PROHIBITIVE", "path": "sovereign.third_party_inference_required", "op": "eq", "value": false, "required": true},
    {"id": "tvc_route_admitted", "class": "REQUIRED", "path": "tvc.route_admitted", "op": "eq", "value": true, "required": true},
    {"id": "tvc_credential_authority", "class": "PROHIBITIVE", "path": "tvc.credential_authority", "op": "eq", "value": "TV/TVC", "required": true},
    {"id": "no_non_tv_tvc_secret", "class": "PROHIBITIVE", "path": "tvc.non_tv_tvc_secret_or_token_detected", "op": "eq", "value": false, "required": true},
    {"id": "openai_ready", "class": "HUMAN_AUTHORITY", "path": "providers.openai", "op": "eq", "value": "READY_FOR_TVC_EXECUTION", "required": true},
    {"id": "anthropic_ready", "class": "HUMAN_AUTHORITY", "path": "providers.anthropic", "op": "eq", "value": "READY_FOR_TVC_EXECUTION", "required": true},
    {"id": "deepseek_ready", "class": "HUMAN_AUTHORITY", "path": "providers.deepseek", "op": "eq", "value": "READY_FOR_TVC_EXECUTION", "required": true},
    {"id": "kimi_ready", "class": "HUMAN_AUTHORITY", "path": "providers.kimi", "op": "eq", "value": "READY_FOR_TVC_EXECUTION", "required": true},
    {"id": "manifest_valid", "class": "REQUIRED", "path": "test.manifest_valid", "op": "eq", "value": true, "required": true},
    {"id": "task_blob_exact", "class": "REQUIRED", "path": "test.task_blob_exact", "op": "eq", "value": true, "required": true},
    {"id": "plan_ready", "class": "REQUIRED", "path": "test.plan_state", "op": "eq", "value": "READY", "required": true},
    {"id": "primary_provider_stegverse", "class": "PROHIBITIVE", "path": "test.primary_provider", "op": "eq", "value": "stegverse_local", "required": true},
    {"id": "all_nine_logical_lanes_ready", "class": "REQUIRED", "path": "test.ready_lane_count", "op": "eq", "value": 9, "required": true},
    {"id": "five_execution_groups_ready", "class": "REQUIRED", "path": "test.ready_execution_group_count", "op": "eq", "value": 5, "required": true},
    {"id": "source_validation_observed", "class": "REQUIRED", "path": "validation.source_validation_observed", "op": "eq", "value": true, "required": true},
    {"id": "evidence_sink_ready", "class": "REQUIRED", "path": "evidence.sink_ready", "op": "eq", "value": true, "required": true},
    {"id": "no_duplicate_execution_claim", "class": "PROHIBITIVE", "path": "claims.conflicting_active_claim", "op": "eq", "value": false, "required": true}
  ],
  "allow_transition": "ACQUIRE_FRESH_TEST_RUN_CLAIM_AND_EXECUTE",
  "blocked_transition": "WAIT_FOR_NEXT_AUTHORITATIVE_STATE_CHANGE",
  "fail_closed_transition": "FAIL_CLOSED_REVIEW_REQUIRED"
}
