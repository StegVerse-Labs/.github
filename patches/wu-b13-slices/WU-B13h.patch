+            'STAMP=$(date +%s)\npython c.py --hb-epoch "$STAMP"',
+            'LEDGER_HEAD_HB_EPOCH=$(python scripts/organization_ledger_head_epoch.py --now)\n'
+            'python c.py --hb-epoch "$LEDGER_HEAD_HB_EPOCH"',
+        )
