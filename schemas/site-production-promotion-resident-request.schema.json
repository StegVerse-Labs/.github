{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/site-production-promotion-resident-request/v1",
  "title": "SPPA resident execution request (stegverse.resident-execution-request/v1, mode SITE_PRODUCTION_PROMOTION_AUTHORIZATION)",
  "description": "A committed request at control/resident-execution-request.d/site-production-promotion-001.json that scripts/consume_site_production_promotion_request.py evaluates through scripts/authorize_site_production_promotion.py against the supplied organization ledger. A request is never authority; the SPPA receipt that reads back is the record.",
  "type": "object",
  "required": ["schema", "state", "task_id", "mode", "entrypoint", "transition", "request_id", "credential_authority",
               "github_token_runtime_authority", "authority_effect", "github_token_required",
               "network_source_fetch_allowed", "second_machine_required", "heartbeat_grants_execution_authority",
               "request_grants_promotion_authority", "provider_settings_change_allowed",
               "deployment_performed_by_consumer", "sppa_remains_promotion_authority_record",
               "promotion_request", "promotion_request_sha256"],
  "properties": {
    "schema": {"const": "stegverse.resident-execution-request/v1"},
    "state": {"const": "REQUESTED"},
    "task_id": {"const": "STEGVERSE-WORKSPACE-ANY-DEVICE-KV-SURFACE-001"},
    "mode": {"const": "SITE_PRODUCTION_PROMOTION_AUTHORIZATION"},
    "entrypoint": {"const": "scripts/consume_site_production_promotion_request.py"},
    "transition": {"const": "scripts/authorize_site_production_promotion.py"},
    "request_id": {"type": "string", "minLength": 1},
    "credential_authority": {"const": "TV/TVC"},
    "github_token_runtime_authority": {"const": "NONE"},
    "authority_effect": {"const": "NONE_REQUEST_ONLY"},
    "github_token_required": {"const": false},
    "network_source_fetch_allowed": {"const": false},
    "second_machine_required": {"const": false},
    "heartbeat_grants_execution_authority": {"const": false},
    "request_grants_promotion_authority": {"const": false},
    "provider_settings_change_allowed": {"const": false},
    "deployment_performed_by_consumer": {"const": false},
    "sppa_remains_promotion_authority_record": {"const": true},
    "promotion_request": {"type": "object", "properties": {"schema": {"const": "stegverse.site-production-promotion-request/v1"}}},
    "promotion_request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
