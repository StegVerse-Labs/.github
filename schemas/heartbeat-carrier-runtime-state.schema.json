{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StegVerse-Labs/.github/schemas/heartbeat-carrier-runtime-state.schema.json",
  "title": "StegVerse Heartbeat Carrier Runtime State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "epoch",
    "generation",
    "role",
    "reference_frame",
    "frequency_rule",
    "authority_effect",
    "activation_state",
    "legacy_cutover"
  ],
  "properties": {
    "schema": {"const": "stegverse.heartbeat-carrier-runtime-state/v1"},
    "epoch": {"type": "integer", "minimum": 29},
    "generation": {"type": "integer", "minimum": 0},
    "last_cycle_at": {"type": ["string", "null"]},
    "role": {"const": "REGULATORY_CARRIER_REFERENCE_FRAME"},
    "reference_frame": {"type": "string", "pattern": "^heartbeat_epoch:[0-9]+$"},
    "frequency_rule": {"enum": ["INDEPENDENT_OSCILLATOR_10MS_PHASE_TRAVEL", "GATE_PASSBAND_DERIVED"]},
    "authority_effect": {"const": "NONE"},
    "activation_state": {"enum": ["PREPARED", "ACTIVE"]},
    "oscillator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanism",
        "period_ns",
        "phase_travel_time_ms",
        "reference_increment_interval_ms",
        "reference_frequency_hz",
        "anchor_epoch",
        "anchor_unix_ns",
        "progression_dependency",
        "downstream_gating",
        "observation_is_causal",
        "sampled_unix_ns",
        "sampled_reference_epoch",
        "phase_offset_ns",
        "elapsed_quanta_from_anchor",
        "snapshot_is_observation_only"
      ],
      "properties": {
        "mechanism": {"const": "INDEPENDENT_PHASE_OSCILLATOR"},
        "period_ns": {"const": 10000000},
        "phase_travel_time_ms": {"const": 10},
        "reference_increment_interval_ms": {"const": 10},
        "reference_frequency_hz": {"const": 100},
        "anchor_epoch": {"type": "integer", "minimum": 0},
        "anchor_unix_ns": {"type": "integer", "minimum": 0},
        "progression_dependency": {"const": "OSCILLATOR_ONLY"},
        "downstream_gating": {"const": false},
        "observation_is_causal": {"const": false},
        "sampled_unix_ns": {"type": "integer", "minimum": 0},
        "sampled_reference_epoch": {"type": "integer", "minimum": 0},
        "phase_offset_ns": {"type": "integer", "minimum": 0, "maximum": 9999999},
        "elapsed_quanta_from_anchor": {"type": "integer", "minimum": 0},
        "snapshot_is_observation_only": {"const": true}
      }
    },
    "legacy_cutover": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacy_schema",
        "legacy_epoch",
        "legacy_generation",
        "legacy_state_sha256",
        "source_ref",
        "closed"
      ],
      "properties": {
        "legacy_schema": {"const": "stegverse.org-heartbeat-state/v1"},
        "legacy_epoch": {"const": 29},
        "legacy_generation": {"type": "integer", "minimum": 0},
        "legacy_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_ref": {"const": "control/heartbeat-state.json"},
        "closed": {"type": "boolean"}
      }
    },
    "portable_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "physical_execution_surface",
        "portable_receipt_sha256",
        "verified",
        "authority_effect"
      ],
      "properties": {
        "contract_id": {"type": "string", "minLength": 1},
        "physical_execution_surface": {"const": "CURRENT_USER_IPHONE"},
        "portable_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verified": {"const": true},
        "authority_effect": {"const": "NONE"},
        "execution_provider": {"type": "string", "minLength": 1},
        "provider_role": {"enum": ["PRIMARY", "FALLBACK_ONLY"]},
        "required_dependency": {"const": false},
        "runtime_authority": {"const": "StegVerse"}
      }
    }
  }
}
