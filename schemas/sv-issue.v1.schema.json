{
  "$id": "stegverse.sv_issue.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claim": {
      "description": "projection of a WorkerCoordinator claim/fence only",
      "required": [
        "claim_ref",
        "fence_ref",
        "projection_only"
      ],
      "type": "object"
    },
    "closed_by": {
      "type": "object"
    },
    "disposition": {
      "properties": {
        "disposition": {
          "enum": [
            "DENY",
            "FAIL_CLOSED"
          ]
        },
        "failed_predicate": {
          "minLength": 1,
          "type": "string"
        },
        "failure_code": {
          "minLength": 1,
          "type": "string"
        },
        "next_attempt": {
          "minLength": 1,
          "type": "string"
        },
        "owning_existing_goal": {
          "minLength": 1,
          "type": "string"
        },
        "required_evidence_or_repair": {
          "minLength": 1,
          "type": "string"
        },
        "retry_entrypoint": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "disposition",
        "failure_code",
        "failed_predicate",
        "required_evidence_or_repair",
        "retry_entrypoint",
        "owning_existing_goal",
        "next_attempt"
      ],
      "type": "object"
    },
    "hb_epoch": {
      "description": "supplied; value >= 32 (org-kernel/kernel.py::supplied_epoch_failure); never from a clock",
      "pattern": "^[0-9]+$",
      "type": "string"
    },
    "issue_id": {
      "description": "sha256 over failure_code, failed_predicate, violated rule_id, owning_existing_goal, retry_entrypoint",
      "pattern": "^svi:[0-9a-f]{64}$",
      "type": "string"
    },
    "issue_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "lifecycle_state": {
      "enum": [
        "OPENED",
        "CLAIMED",
        "RESOLVED",
        "CLOSED_BY_INVARIANT",
        "SUPERSEDED"
      ]
    },
    "observed_base": {
      "additionalProperties": false,
      "properties": {
        "ledger_head": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "registry_generation": {
          "minimum": 0,
          "type": "integer"
        },
        "tree_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "required": [
        "registry_generation",
        "ledger_head"
      ],
      "type": "object"
    },
    "opened_by_session": {
      "minLength": 1,
      "type": "string"
    },
    "owning_goal": {
      "minLength": 1,
      "type": "string"
    },
    "projection": {
      "description": "one-way GitHub projection; never authority",
      "type": [
        "object",
        "null"
      ]
    },
    "resolution_class": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "resolved_by": {
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "stegverse.sv_issue.v1"
    },
    "source_receipt": {
      "properties": {
        "evidence_path": {
          "minLength": 1,
          "type": "string"
        },
        "evidence_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "ORGANIZATION_LEDGER_RECEIPT",
            "REPOSITORY_LEDGER_RECEIPT",
            "MIGRATION_EVIDENCE"
          ]
        },
        "ledger_ref": {
          "minLength": 1,
          "type": "string"
        },
        "receipt_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "violated_invariant": {
      "properties": {
        "blob_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "file": {
          "minLength": 1,
          "type": "string"
        },
        "invariant_declared": {
          "type": "boolean"
        },
        "repository": {
          "minLength": 1,
          "type": "string"
        },
        "rule_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "file"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema",
    "issue_id",
    "disposition",
    "violated_invariant",
    "source_receipt",
    "resolution_class",
    "lifecycle_state",
    "observed_base",
    "owning_goal",
    "opened_by_session",
    "hb_epoch",
    "issue_sha256"
  ],
  "title": "SV_ISSUE (record kind in STEGVERSE-CANONICAL-WORK-COORDINATION-001)",
  "type": "object"
}
