{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StegVerse-Labs/.github/schemas/worker-reconstruction-proof.schema.json",
  "title": "StegVerse worker successor reconstruction proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "reconstruction_id",
    "task_id",
    "goal_id",
    "parent_task_id",
    "authority_source",
    "policy_version",
    "last_valid_fencing_token",
    "checkpoint_ref",
    "checkpoint_sha256",
    "master_records_refs",
    "evidence_lineage_refs",
    "unresolved_work",
    "reconstruction_status",
    "execution_authority"
  ],
  "properties": {
    "schema": {"const": "stegverse.worker-reconstruction-proof/v0.1"},
    "reconstruction_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "goal_id": {"type": "string", "minLength": 1},
    "parent_task_id": {"type": "string", "minLength": 1},
    "authority_source": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "last_valid_fencing_token": {"type": "integer", "minimum": 1},
    "checkpoint_ref": {"type": "string", "minLength": 1},
    "checkpoint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "master_records_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^master-records/"}
    },
    "evidence_lineage_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "unresolved_work": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "reconstruction_status": {"const": "PASS"},
    "execution_authority": {"const": false}
  }
}
