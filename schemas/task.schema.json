{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StegVerse-Labs/.github/schemas/task.schema.json",
  "title": "StegVerse Organization Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "organization", "goal", "status", "requirements", "dependencies", "requested_at"],
  "properties": {
    "schema": {"const": "stegverse.org-task/v0.2"},
    "task_id": {"type": "string", "pattern": "^TASK-[0-9]{4}-[0-9]{4,}$"},
    "organization": {"const": "StegVerse-Labs"},
    "goal": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed", "queued", "active", "checkin_pending", "completed"]},
    "flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["blocked", "suspended", "superseded", "reconciliation_required"]}
    },
    "requested_at": {"type": "string", "format": "date-time"},
    "priority_class": {"enum": ["normal", "elevated", "critical", "security", "release"]},
    "rank_reason": {"type": "array", "items": {"type": "string"}},
    "requirements": {
      "type": "object",
      "required": ["mandatory", "optional"],
      "properties": {
        "mandatory": {"type": "array", "items": {"$ref": "claim.schema.json"}},
        "optional": {"type": "array", "items": {"$ref": "claim.schema.json"}}
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^TASK-[0-9]{4}-[0-9]{4,}$"}
    },
    "workspace": {
      "type": "object",
      "properties": {
        "branch": {"type": "string"},
        "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "merge_target": {"type": "string"},
        "direct_push_allowed": {"type": "boolean"},
        "pull_request_required": {"type": "boolean"}
      }
    },
    "supersedes": {"type": "string", "pattern": "^TASK-[0-9]{4}-[0-9]{4,}$"}
  }
}
