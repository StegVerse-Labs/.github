{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/system-ai-goal.schema.json",
  "title": "StegVerse System AI Goal",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal_id", "entity_id", "title", "objective", "state", "success_predicates", "forbidden_shortcuts", "execution_dependencies", "authority", "successor_goal"],
  "properties": {
    "goal_id": {"type": "string", "minLength": 1},
    "entity_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "state": {"enum": ["PLANNED", "ACTIVE", "BLOCKED", "ACHIEVED", "FAILED", "SUPERSEDED"]},
    "success_predicates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "forbidden_shortcuts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "execution_dependencies": {"type": "array", "items": {"type": "string"}},
    "authority": {
      "type": "object",
      "required": ["goal_assignment_authority", "credential_authority", "policy_authority", "route_authority", "completion_adjudicator", "entity_may_self_certify_completion", "heartbeat_grants_execution_authority", "model_output_authority"],
      "properties": {
        "goal_assignment_authority": {"const": "StegVerse-Labs/.github"},
        "credential_authority": {"const": "TV/TVC"},
        "policy_authority": {"const": "StegVerse-Labs/TV"},
        "route_authority": {"const": "StegVerse-Labs/TVC"},
        "completion_adjudicator": {"const": "EVIDENCE_ONLY"},
        "entity_may_self_certify_completion": {"const": false},
        "heartbeat_grants_execution_authority": {"const": false},
        "model_output_authority": {"const": "NONE"}
      },
      "additionalProperties": false
    },
    "successor_goal": {
      "type": "object",
      "required": ["goal_id", "activate_only_after", "objective"],
      "properties": {
        "goal_id": {"type": "string"},
        "activate_only_after": {"const": "SYSTEM_AI_ACTIVE"},
        "objective": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
