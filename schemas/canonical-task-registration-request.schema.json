{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/canonical-task-registration-request.schema.json",
  "title": "StegVerse canonical task registration request (manifest)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "task_id", "observed_registry_generation", "record", "vector", "authority_effect"],
  "properties": {
    "schema": {"const": "stegverse.canonical-task-registration-request/v1"},
    "request_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "observed_registry_generation": {"type": "integer", "minimum": 0},
    "registration_mode": {"enum": ["NEW_IDENTITY", "EXISTING_IDENTITY"]},
    "issue": {"type": "string"},
    "allocation_request_ref": {"type": ["string", "null"]},
    "collision_analysis": {"type": "array", "items": {"type": "string"}},
    "record": {"type": "object"},
    "sealed_scope": {
      "type": ["object", "null"],
      "description": "GOAL_SCOPE_SEALED (scripts/goal_scope_seal.py): required on NEW_IDENTITY; scope_digest = sha256 over the canonical scope JSON",
      "additionalProperties": false,
      "required": ["schema", "scope", "scope_digest", "supersedes_scope_digest"],
      "properties": {
        "schema": {"const": "stegverse.goal-scope-seal/v1"},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["goal", "targets", "expected_evidence_predicates", "finish_point"],
          "properties": {
            "goal": {"type": "string", "minLength": 1},
            "targets": {"type": "object"},
            "expected_evidence_predicates": {"type": "array", "items": {"type": "string"}},
            "finish_point": {
              "type": "object",
              "required": ["acceptance_test", "predicate", "verifier_entrypoint", "lowest_supported_mode"],
              "properties": {
                "acceptance_test": {"type": "string", "minLength": 1},
                "predicate": {"type": "string", "minLength": 1},
                "verifier_entrypoint": {"type": "string", "minLength": 1},
                "lowest_supported_mode": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "scope_digest": {"type": "string", "minLength": 71},
        "supersedes_scope_digest": {"type": ["string", "null"]}
      }
    },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_metrics", "metric_evidence", "evidence_refs", "observed_at"],
      "properties": {
        "exact_metrics": {"type": "object"},
        "metric_evidence": {"type": "object"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "observed_at": {"type": "string", "minLength": 1}
      }
    },
    "authority_effect": {"const": "NONE_REGISTRATION_ONLY"}
  }
}
