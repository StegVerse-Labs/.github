{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"stegverse:workercoordinator-portable-checkout-package:v1",
  "title":"Portable WorkerCoordinator Checkout Package",
  "type":"object",
  "required":["schema","portable_authority_epoch","canonical_authority_owner","authority_domain","execution_surface","predecessor_generation_floor","predecessor_registry_git_blob_sha","task","worker","handoff_authority","source_binding","dependencies_complete","execution_authorized","semantic_state_current","worker_resolved","credential_authority","github_token_runtime_authority","heartbeat_grants_execution_authority","parallel_workercoordinator_claim_issuance_allowed","governed_transfer_required_before_other_surface_claims"],
  "properties":{
    "schema":{"const":"stegverse.workercoordinator-portable-checkout-package/v1"},
    "canonical_authority_owner":{"const":"StegVerse-Labs/.github WorkerCoordinator"},
    "authority_domain":{"const":"INDEPENDENT_TASK_CONTROL"},
    "execution_surface":{"const":"CURRENT_USER_IPHONE"},
    "predecessor_generation_floor":{"type":"integer","minimum":0},
    "predecessor_registry_git_blob_sha":{"type":"string","pattern":"^[a-f0-9]{40}$"},
    "credential_authority":{"const":"TV/TVC"},
    "github_token_runtime_authority":{"const":"NONE"},
    "heartbeat_grants_execution_authority":{"const":false},
    "parallel_workercoordinator_claim_issuance_allowed":{"const":false},
    "governed_transfer_required_before_other_surface_claims":{"const":true}
  }
}
