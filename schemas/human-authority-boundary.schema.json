{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StegVerse-Labs/.github/schemas/human-authority-boundary.schema.json",
  "title": "StegVerse human authority boundary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "boundary_id",
    "task_id",
    "requested_decision",
    "authority_source",
    "evidence_refs",
    "resume_trigger",
    "status",
    "automation_terminal"
  ],
  "properties": {
    "schema": {"const": "stegverse.human-authority-boundary/v0.1"},
    "boundary_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "requested_decision": {"type": "string", "minLength": 1},
    "authority_source": {"type": "string", "minLength": 1},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "resume_trigger": {"type": "string", "minLength": 1},
    "status": {"enum": ["PENDING", "RESOLVED", "WITHDRAWN"]},
    "resolution_ref": {"type": ["string", "null"]},
    "automation_terminal": {"const": true}
  }
}
