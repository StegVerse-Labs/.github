{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/canonical-task-registration-transition-receipt.schema.json",
  "title": "StegVerse canonical task registration transition receipt",
  "type": "object",
  "required": ["schema", "transition", "mode", "request_sha256", "disposition", "authority_effect",
               "workercoordinator_claim_or_fence_minted", "intr_admission_minted", "execution_authority_minted",
               "clock_read", "organization_ledger_appended"],
  "properties": {
    "schema": {"const": "stegverse.canonical-task-registration-transition-receipt/v1"},
    "transition": {"const": "CANONICAL_TASK_REGISTRATION"},
    "mode": {"enum": ["plan", "apply", "verify"]},
    "request_id": {"type": ["string", "null"]},
    "request_sha256": {"type": "string", "minLength": 71},
    "disposition": {"enum": ["ALLOW", "FAIL_CLOSED"]},
    "authority_effect": {"const": "NONE_REGISTRATION_ONLY"},
    "workercoordinator_claim_or_fence_minted": {"const": false},
    "intr_admission_minted": {"const": false},
    "execution_authority_minted": {"const": false},
    "clock_read": {"const": false},
    "organization_ledger_appended": {"const": false},
    "organization_ledger_entrypoint": {"type": "string"},
    "evidence": {"type": "object"},
    "derived_files": {"type": "object"},
    "failure_code": {"type": "string"},
    "failed_predicate": {"type": "string"},
    "detail": {"type": "string"},
    "required_evidence_or_repair": {"type": "string"},
    "retry_entrypoint": {"type": "string"},
    "owning_existing_goal": {"type": "string"},
    "next_attempt": {"type": "string"},
    "consequence_committed": {"const": false}
  }
}
