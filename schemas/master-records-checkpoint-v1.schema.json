{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/master-records-checkpoint-v1.schema.json",
  "title": "MasterRecordsCheckpoint/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "origin",
    "checkpoint_sequence",
    "first_sequence",
    "last_sequence",
    "tree_size",
    "merkle_root",
    "predecessor_checkpoint_digest",
    "closure_receipt_sha256",
    "canonicalization",
    "hash_algorithm",
    "signature_profile",
    "signing_key_id",
    "signature",
    "interoperability_profile",
    "communication_contract"
  ],
  "properties": {
    "schema": {
      "const": "stegverse.master-records-checkpoint/v1"
    },
    "origin": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "first_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "last_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "tree_size": {
      "type": "integer",
      "minimum": 1
    },
    "merkle_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "predecessor_checkpoint_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "closure_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canonicalization": {
      "const": "stegverse-master-records-merkle/v1"
    },
    "hash_algorithm": {
      "const": "sha256"
    },
    "signature_profile": {
      "type": "string",
      "minLength": 1
    },
    "signing_key_id": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": "string",
      "minLength": 1
    },
    "interoperability_profile": {
      "const": "MasterRecordsCheckpoint/v1"
    },
    "communication_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "registered_node_required",
        "manifest_intent_required",
        "payload_commitment_field",
        "checkpoint_digest_binding",
        "receiving_disposition",
        "write_once_transfer_admission_receipt_required",
        "participating_runtime_implementation_required",
        "external_conformance_claimed"
      ],
      "properties": {
        "protocol": {
          "const": "stegverse.interlock-intr/v1"
        },
        "registered_node_required": {
          "const": true
        },
        "manifest_intent_required": {
          "const": true
        },
        "payload_commitment_field": {
          "const": "checkpoint_digest"
        },
        "checkpoint_digest_binding": {
          "const": "EXACT"
        },
        "receiving_disposition": {
          "type": "array",
          "prefixItems": [
            {
              "const": "ALLOW"
            },
            {
              "const": "DENY"
            },
            {
              "const": "FAIL_CLOSED"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "write_once_transfer_admission_receipt_required": {
          "const": true
        },
        "participating_runtime_implementation_required": {
          "const": false
        },
        "external_conformance_claimed": {
          "const": false
        }
      }
    }
  }
}
