{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StegVerse-Labs/.github/schemas/worker-mutation-scope-receipt.schema.json",
  "title": "StegVerse worker mutation scope receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "claim_id", "fencing_token", "heartbeat_epoch", "decision", "reason", "changed_paths", "allowed_paths", "authority_effect"],
  "properties": {
    "schema": {"const": "stegverse.worker-mutation-scope-receipt/v0.1"},
    "task_id": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string", "minLength": 1},
    "fencing_token": {"type": "integer", "minimum": 1},
    "heartbeat_epoch": {"type": "integer", "minimum": 0},
    "decision": {"enum": ["ALLOW", "DENY"]},
    "reason": {"type": "string", "minLength": 1},
    "changed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authority_effect": {"const": "none_adapter_scope_enforcement_only"}
  }
}
