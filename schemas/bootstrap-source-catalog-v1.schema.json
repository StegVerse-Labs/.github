{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/bootstrap-source-catalog/v1",
  "title": "StegVerse Bootstrap Source Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "catalog_version",
    "state",
    "source_identity_scheme",
    "component_count",
    "components",
    "source_identity_set_sha256",
    "upstream_source_prep_receipt_sha256",
    "source_package_contract",
    "github_platform_required",
    "specific_external_platform_required",
    "network_locator_required",
    "package_integrity_confers_execution_authority",
    "execution_authority",
    "authority_effect"
  ],
  "properties": {
    "schema": {
      "const": "stegverse.bootstrap.source-catalog/v1"
    },
    "catalog_version": {
      "const": "1.0.0"
    },
    "state": {
      "const": "FROZEN"
    },
    "source_identity_scheme": {
      "const": "sha256-content-manifest"
    },
    "component_count": {
      "const": 4
    },
    "components": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_id",
          "source_identity"
        ],
        "properties": {
          "component_id": {
            "enum": [
              "stegverse.sdk",
              "stegverse.stegcore",
              "stegverse.core-lite",
              "stegverse.master-records"
            ]
          },
          "source_identity": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "source_identity_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "upstream_source_prep_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_package_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "version"
      ],
      "properties": {
        "schema": {
          "const": "stegverse.source-package/v1"
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "github_platform_required": {
      "const": false
    },
    "specific_external_platform_required": {
      "const": false
    },
    "network_locator_required": {
      "const": false
    },
    "package_integrity_confers_execution_authority": {
      "const": false
    },
    "execution_authority": {
      "const": "NONE"
    },
    "authority_effect": {
      "const": "NONE_IDENTITY_FREEZE_ONLY"
    }
  }
}
