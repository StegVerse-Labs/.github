{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/bootstrap-release-candidate/v1",
  "title": "StegVerse Bootstrap v1 Release Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate_version",
    "state",
    "source_identity_scheme",
    "source_catalog",
    "source_package_contract",
    "device_materialization_contract",
    "source_freeze_receipt_sha256",
    "github_platform_required",
    "specific_external_platform_required",
    "network_locator_required",
    "transport_implementation_required",
    "credential_required",
    "package_integrity_confers_execution_authority",
    "release_activated",
    "publication_performed",
    "execution_authority",
    "authority_effect",
    "candidate_identity"
  ],
  "properties": {
    "schema": {
      "const": "stegverse.bootstrap.release-candidate/v1"
    },
    "candidate_version": {
      "const": "1.0.0-rc.1"
    },
    "state": {
      "const": "FROZEN"
    },
    "source_identity_scheme": {
      "const": "sha256-content-manifest"
    },
    "source_catalog": {
      "type": "object"
    },
    "source_package_contract": {
      "type": "object"
    },
    "device_materialization_contract": {
      "type": "object"
    },
    "source_freeze_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "github_platform_required": {
      "const": false
    },
    "specific_external_platform_required": {
      "const": false
    },
    "network_locator_required": {
      "const": false
    },
    "transport_implementation_required": {
      "const": false
    },
    "credential_required": {
      "const": false
    },
    "package_integrity_confers_execution_authority": {
      "const": false
    },
    "release_activated": {
      "const": false
    },
    "publication_performed": {
      "const": false
    },
    "execution_authority": {
      "const": "NONE"
    },
    "authority_effect": {
      "const": "NONE_RELEASE_CANDIDATE_FREEZE_ONLY"
    },
    "candidate_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
